      "id": 7,
      "title": "Database Connections (MySQL)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "mysql_global_status_threads_connected or vector(0)", "legendFormat": "Active Connections", "refId": "A" }]
    },
    {
      "id": 8,
      "title": "MySQL Queries Per Second (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "rate(mysql_global_status_queries[1m]) or vector(0)", "legendFormat": "Queries/sec", "refId": "A" }]
    },
    {
      "id": 9,
      "title": "Node.js Process Memory Usage (Bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
