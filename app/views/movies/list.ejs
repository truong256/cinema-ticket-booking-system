<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <div class="section-header">
        <div>
            <h1 class="section-title"><i class="fas fa-clapperboard"></i> Danh Sách Phim & Sự Kiện</h1>
            <p style="color: var(--text-secondary); font-size: 0.95rem;">Tất cả các bộ phim bom tấn đang chiếu và sắp ra mắt</p>
        </div>
    </div>

    <!-- Genre Filter Pills -->
    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 2rem;">
        <a href="/movies" class="btn btn-sm <%= !currentGenre ? 'btn-primary' : 'btn-secondary' %>">Tất cả thể loại</a>
        <a href="/movies?genre=Hành động" class="btn btn-sm <%= currentGenre === 'Hành động' ? 'btn-primary' : 'btn-secondary' %>">Hành động</a>
        <a href="/movies?genre=Khoa học viễn tưởng" class="btn btn-sm <%= currentGenre === 'Khoa học viễn tưởng' ? 'btn-primary' : 'btn-secondary' %>">Khoa học viễn tưởng</a>
        <a href="/movies?genre=Tâm lý" class="btn btn-sm <%= currentGenre === 'Tâm lý' ? 'btn-primary' : 'btn-secondary' %>">Tâm lý</a>
        <a href="/movies?genre=Hoạt hình" class="btn btn-sm <%= currentGenre === 'Hoạt hình' ? 'btn-primary' : 'btn-secondary' %>">Hoạt hình</a>
        <a href="/movies?genre=Gia đình" class="btn btn-sm <%= currentGenre === 'Gia đình' ? 'btn-primary' : 'btn-secondary' %>">Gia đình</a>
    </div>

    <div class="movies-grid">
        <% if (movies && movies.length > 0) { %>
            <% movies.forEach(movie => { %>
                <div class="movie-card">
                    <div class="movie-poster-wrap">
                        <img src="<%= movie.poster_url %>" alt="<%= movie.title %>" class="movie-poster">
                        <span class="age-badge <%= movie.age_rating %>"><%= movie.age_rating %></span>
                    </div>
                    <div class="movie-info">
                        <span class="movie-genre"><%= movie.genre %></span>
                        <h3 class="movie-title"><%= movie.title %></h3>
                        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            <%= movie.description %>
                        </p>
                        <div class="movie-meta">
                            <span><i class="far fa-clock"></i> <%= movie.duration_minutes %> phút</span>
                            <a href="/movies/<%= movie.id %>" class="btn btn-primary btn-sm" style="margin-left: auto;">
                                Chi tiết & Đặt vé <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 3rem;">
                <i class="fas fa-search" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
                <p style="color: var(--text-secondary);">Không tìm thấy phim phù hợp với tiêu chí lọc.</p>
                <a href="/movies" class="btn btn-secondary btn-sm" style="margin-top: 1rem;">Xem tất cả</a>
            </div>
        <% } %>
    </div>
</main>

<%- include('../partials/footer') %>
