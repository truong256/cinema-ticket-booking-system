<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <!-- Header -->
    <div class="section-header">
        <div>
            <span class="brand-badge gold" style="margin-bottom: 0.5rem;">LỊCH CHIẾU QUỐC GIA &bull; TOÀN HỆ THỐNG</span>
            <h1 class="section-title">
                Lịch Chiếu Phim Khả Dụng
            </h1>
            <p class="section-subtitle">Cập nhật liên tục các suất chiếu bom tấn mới nhất tại các cụm rạp CineStar và Galaxy Cinema</p>
        </div>
    </div>

    <!-- Quick Room Type Filter Bar -->
    <div style="display: flex; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 2.5rem; align-items: center;">
        <span style="font-size: 0.88rem; font-weight: 700; color: var(--text-muted); margin-right: 0.35rem; text-transform: uppercase; letter-spacing: 0.5px;">
            Định dạng:
        </span>
        <button type="button" class="btn btn-sm btn-primary showtime-filter active" data-type="all">Tất cả phòng</button>
        <button type="button" class="btn btn-sm btn-secondary showtime-filter" data-type="IMAX">Phòng IMAX</button>
        <button type="button" class="btn btn-sm btn-secondary showtime-filter" data-type="VIP">Phòng VIP</button>
        <button type="button" class="btn btn-sm btn-secondary showtime-filter" data-type="Standard">Standard</button>
    </div>

    <% if (locals.error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (!showtimes || showtimes.length === 0) { %>
        <div class="card" style="text-align: center; padding: 4.5rem 2rem;">
            <h3 style="color: #FFFFFF; margin-bottom: 0.5rem; font-size: 1.3rem; font-weight: 700;">Hiện chưa có suất chiếu nào được lên lịch</h3>
            <p style="color: var(--text-secondary); max-width: 440px; margin: 0 auto 1.5rem;">Vui lòng quay lại sau hoặc duyệt qua danh mục phim bom tấn để xem thông tin chi tiết.</p>
            <a href="/movies" class="btn btn-secondary btn-sm">Xem danh mục phim</a>
        </div>
    <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;" id="showtimesGrid">
            <% showtimes.forEach(st => { %>
                <div class="card card-hover showtime-item" data-room-type="<%= st.room_type %>" style="display: flex; flex-direction: column; justify-content: space-between; padding: 1.35rem;">
                    <div>
                        <div style="display: flex; gap: 1rem; margin-bottom: 1.25rem;">
                            <img src="<%= st.poster_url %>" alt="<%= st.movie_title %>" loading="lazy" style="width: 84px; height: 122px; object-fit: cover; border-radius: var(--radius-sm); flex-shrink: 0; box-shadow: var(--shadow-sm); border: 1px solid var(--border-color);" onerror="this.onerror=null; this.src='/images/default_poster.jpg';">
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; gap: 0.4rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
                                    <span class="age-badge <%= st.age_rating %>" style="position: static; font-size: 0.7rem; padding: 0.15rem 0.45rem; box-shadow: none;"><%= st.age_rating %></span>
                                    <span class="brand-badge <%= st.room_type === 'IMAX' ? 'gold' : '' %>" style="font-size: 0.7rem; padding: 0.15rem 0.45rem;"><%= st.room_type %></span>
                                </div>
                                <h3 style="font-size: 1.1rem; font-weight: 700; color: #FFFFFF; margin-bottom: 0.35rem; line-height: 1.3;"><%= st.movie_title %></h3>
                                <p style="font-size: 0.82rem; color: var(--text-muted);"><%= st.duration_minutes %> phút</p>
                            </div>
                        </div>

                        <div style="border-top: 1px solid var(--border-color); padding-top: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
                            <p style="margin-bottom: 0.35rem; color: #FFFFFF;"><strong><%= st.cinema_name %></strong></p>
                            <p style="margin-bottom: 0.35rem; color: var(--text-secondary);"><%= st.room_name %></p>
                            <p style="margin-bottom: 0.35rem; color: var(--color-gold); font-weight: 700;"><%= new Date(st.start_time).toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' }) %></p>
                            <p style="color: var(--text-muted);">Giá vé từ: <strong style="color: var(--color-gold); font-size: 0.95rem;"><%= Number(st.price_regular).toLocaleString('vi-VN') %> đ</strong></p>
                        </div>
                    </div>

                    <a href="/booking/showtime/<%= st.id %>" class="btn btn-primary" style="width: 100%;">
                        Chọn Ghế Ngồi
                    </a>
                </div>
            <% }); %>
        </div>
    <% } %>
</main>

<script>
// Filter showtimes by room type
document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.showtime-filter');
    const items = document.querySelectorAll('#showtimesGrid .showtime-item');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-secondary');
            });
            btn.classList.remove('btn-secondary');
            btn.classList.add('btn-primary', 'active');

            const filterType = btn.getAttribute('data-type');
            items.forEach(item => {
                const roomType = item.getAttribute('data-room-type') || '';
                if (filterType === 'all' || roomType.toLowerCase() === filterType.toLowerCase()) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        });
    });
});
</script>

<%- include('../partials/footer') %>
