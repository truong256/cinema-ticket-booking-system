<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-wrapper" style="max-width: 640px; text-align: center; padding-top: 5rem; padding-bottom: 5rem;">
    <div class="card" style="padding: 3.5rem 2.5rem; border-color: rgba(229, 9, 20, 0.3); background: radial-gradient(circle at 50% 20%, rgba(229, 9, 20, 0.12) 0%, rgba(23, 30, 43, 0.95) 75%); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(229, 9, 20, 0.15); border: 2px solid rgba(229, 9, 20, 0.4); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: var(--color-primary); font-size: 2.2rem;">
            <i class="fas fa-exclamation-triangle"></i>
        </div>

        <div style="font-family: var(--font-heading); font-size: 4.5rem; font-weight: 900; color: var(--color-primary); line-height: 1; letter-spacing: -2px; margin-bottom: 0.75rem; text-shadow: 0 0 30px rgba(229, 9, 20, 0.4);">
            <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
        </div>

        <h2 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 800; color: #ffffff; margin-bottom: 0.75rem;">
            <%= typeof title !== 'undefined' ? title : 'Đã Xảy Ra Sự Cố' %>
        </h2>

        <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: 2.25rem;">
            <%= typeof message !== 'undefined' ? message : 'Máy chủ gặp sự cố trong khi xử lý yêu cầu của bạn. Vui lòng thử lại sau giây lát hoặc quay lại trang chủ.' %>
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/" class="btn btn-primary" style="padding: 0.85rem 1.85rem;">
                <i class="fas fa-home"></i> Quay lại trang chủ
            </a>
            <a href="javascript:history.back()" class="btn btn-secondary" style="padding: 0.85rem 1.5rem;">
                <i class="fas fa-arrow-left"></i> Quay lại trang trước
            </a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
