<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-wrapper" style="max-width: 1280px; padding-top: 1.5rem;">
    <!-- ============================================================== -->
    <!-- SECTION 1 — ABOUT CINEVIBE (CINEMATIC HERO BANNER)            -->
    <!-- ============================================================== -->
    <section class="about-hero" style="background-image: url('/images/about_hero.jpg');">
        <div class="about-hero-overlay"></div>
        <div class="about-hero-content">
            <span class="hero-tag gold" style="margin-bottom: 1rem; display: inline-flex;">
                <i class="fas fa-crown"></i> NỀN TẢNG ĐẶT VÉ ĐIỆN ẢNH THẾ HỆ MỚI
            </span>
            <h1 class="about-hero-title">
                CINEVIBE — Trải Nghiệm Điện Ảnh Trong Tầm Tay
            </h1>
            <p class="about-hero-desc">
                CINEVIBE là nền tảng đặt vé xem phim trực tuyến, giúp bạn dễ dàng khám phá những bộ phim hấp dẫn, tra cứu lịch chiếu, lựa chọn vị trí ghế yêu thích và đặt vé nhanh chóng. Chúng tôi hướng đến trải nghiệm đặt vé thuận tiện, trực quan và hiện đại, để bạn dành nhiều thời gian hơn cho những khoảnh khắc điện ảnh đáng nhớ.
            </p>
            <div class="about-hero-actions">
                <a href="/movies" class="btn btn-primary btn-lg">
                    <i class="fas fa-clapperboard"></i> Khám phá phim
                </a>
                <a href="/showtimes" class="btn btn-secondary btn-lg" style="border-color: rgba(245, 196, 81, 0.4); color: var(--color-gold);">
                    <i class="fas fa-ticket"></i> Đặt vé ngay
                </a>
            </div>
        </div>
    </section>

    <!-- ============================================================== -->
    <!-- SECTION 2 — VÌ SAO CHỌN CINEVIBE? (4 FEATURE CARDS)            -->
    <!-- ============================================================== -->
    <section style="margin-bottom: 5rem;">
        <div class="about-section-header">
            <span class="brand-badge gold">ƯU ĐIỂM VƯỢT TRỘI</span>
            <h2 class="about-section-title">Vì Sao Chọn CINEVIBE?</h2>
            <p class="about-section-desc">
                Được thiết kế tối ưu cho trải nghiệm của người yêu điện ảnh, tinh tế và thuận tiện trong từng thao tác.
            </p>
        </div>

        <div class="features-grid">
            <!-- Feature 1 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <i class="fas fa-compass"></i>
                </div>
                <h3 class="feature-card-title">1. Khám phá phim dễ dàng</h3>
                <p class="feature-card-desc">
                    Tra cứu danh sách phim, thông tin chi tiết và lịch chiếu nhanh chóng với bộ lọc thể loại trực quan.
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper" style="background: rgba(245, 196, 81, 0.12); border-color: rgba(245, 196, 81, 0.25); color: var(--color-gold);">
                    <i class="fas fa-couch"></i>
                </div>
                <h3 class="feature-card-title">2. Lựa chọn ghế trực quan</h3>
                <p class="feature-card-desc">
                    Sơ đồ ghế giúp người dùng chọn vị trí yêu thích và xem giá vé rõ ràng theo từng phân hạng Regular, VIP, Couple.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper" style="background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.25); color: #38bdf8;">
                    <i class="fas fa-ticket-simple"></i>
                </div>
                <h3 class="feature-card-title">3. Đặt vé thuận tiện</h3>
                <p class="feature-card-desc">
                    Quy trình chọn phim, chọn suất chiếu và hoàn tất đặt vé đơn giản, mượt mà trên mọi thiết bị máy tính và di động.
                </p>
            </div>

            <!-- Feature 4 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper" style="background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.25); color: #10B981;">
                    <i class="fas fa-qrcode"></i>
                </div>
                <h3 class="feature-card-title">4. Quản lý vé dễ dàng</h3>
                <p class="feature-card-desc">
                    Người dùng đã đăng nhập có thể theo dõi lịch sử đặt vé và thông tin vé của mình bất cứ lúc nào qua E-Ticket.
                </p>
            </div>
        </div>
    </section>

    <!-- ============================================================== -->
    <!-- SECTION 3 — QUY TRÌNH ĐẶT VÉ (STEP-BY-STEP)                    -->
    <!-- ============================================================== -->
    <section id="booking-process" style="margin-bottom: 5rem; scroll-margin-top: 100px;">
        <div class="about-section-header">
            <span class="brand-badge gold">HƯỚNG DẪN ĐƠN GIẢN</span>
            <h2 class="about-section-title">Quy Trình Đặt Vé Chỉ Với 5 Bước</h2>
            <p class="about-section-desc">
                Trải nghiệm đặt vé thông minh, liền mạch và nhận xác nhận tức thì chỉ với vài bước đơn giản.
            </p>
        </div>

        <div class="steps-grid">
            <!-- Bước 1 -->
            <div class="step-card">
                <div class="step-header">
                    <span class="step-number">01</span>
                    <div class="step-icon">
                        <i class="fas fa-clapperboard"></i>
                    </div>
                </div>
                <h3 class="step-title">Bước 1: Chọn phim</h3>
                <p class="step-desc">
                    Khám phá phim đang chiếu và chọn bộ phim yêu thích từ danh mục điện ảnh phong phú.
                </p>
            </div>

            <!-- Bước 2 -->
            <div class="step-card">
                <div class="step-header">
                    <span class="step-number">02</span>
                    <div class="step-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                </div>
                <h3 class="step-title">Bước 2: Chọn suất chiếu</h3>
                <p class="step-desc">
                    Lựa chọn lịch chiếu, rạp và thời gian phù hợp với kế hoạch giải trí của bạn.
                </p>
            </div>

            <!-- Bước 3 -->
            <div class="step-card" id="seat-guide" style="scroll-margin-top: 100px;">
                <div class="step-header">
                    <span class="step-number">03</span>
                    <div class="step-icon">
                        <i class="fas fa-couch"></i>
                    </div>
                </div>
                <h3 class="step-title">Bước 3: Chọn ghế</h3>
                <p class="step-desc">
                    Chọn ghế thường, VIP hoặc ghế đôi theo cấu hình phòng chiếu và quan sát tổng tiền cập nhật động.
                </p>
            </div>

            <!-- Bước 4 -->
            <div class="step-card">
                <div class="step-header">
                    <span class="step-number">04</span>
                    <div class="step-icon">
                        <i class="fas fa-credit-card"></i>
                    </div>
                </div>
                <h3 class="step-title">Bước 4: Thanh toán</h3>
                <p class="step-desc">
                    Kiểm tra thông tin đặt vé và thực hiện quy trình thanh toán được hệ thống hỗ trợ.
                </p>
            </div>

            <!-- Bước 5 -->
            <div class="step-card">
                <div class="step-header">
                    <span class="step-number">05</span>
                    <div class="step-icon">
                        <i class="fas fa-ticket"></i>
                    </div>
                </div>
                <h3 class="step-title">Bước 5: Nhận vé</h3>
                <p class="step-desc">
                    Xem thông tin xác nhận đặt vé sau khi thanh toán thành công và lưu mã vé điện tử.
                </p>
            </div>
        </div>
    </section>

    <!-- ============================================================== -->
    <!-- SECTION 4 — TRẢI NGHIỆM ĐIỆN ẢNH (CINEMA EXPERIENCE SPLIT)    -->
    <!-- ============================================================== -->
    <section class="experience-section" id="experience" style="scroll-margin-top: 100px;">
        <div class="experience-content">
            <span class="hero-tag gold">KHOẢNH KHẮC ĐÁNG NHỚ</span>
            <h2>Mỗi Bộ Phim Là Một Hành Trình Cảm Xúc</h2>
            <p>
                Điện ảnh không chỉ là thưởng thức một câu chuyện trên màn ảnh rộng, mà là khoảnh khắc đắm chìm vào âm thanh sống động, hình ảnh mãn nhãn và cảm xúc trọn vẹn. Tại CINEVIBE, chúng tôi mong muốn việc chọn chỗ ngồi ưng ý, lựa chọn suất chiếu lý tưởng để cùng bạn bè, gia đình tận hưởng những thước phim đáng nhớ trở nên dễ dàng và thư thái nhất.
            </p>
            <ul class="experience-perks">
                <li class="experience-perk-item">
                    <i class="fas fa-check-circle"></i>
                    <span><strong>Sơ đồ trực quan:</strong> Quan sát không gian phòng chiếu để chọn góc nhìn hoàn hảo nhất cho trải nghiệm điện ảnh của bạn.</span>
                </li>
                <li class="experience-perk-item">
                    <i class="fas fa-check-circle"></i>
                    <span><strong>Suất chiếu linh hoạt:</strong> Đa dạng khung giờ chiếu trong ngày, cập nhật tình trạng ghế trống tức thì theo thời gian thực.</span>
                </li>
                <li class="experience-perk-item">
                    <i class="fas fa-check-circle"></i>
                    <span><strong>Vé điện tử tiện ích:</strong> Dễ dàng tra cứu lại lịch sử đặt chỗ trong tài khoản cá nhân mọi lúc, mọi nơi.</span>
                </li>
            </ul>
        </div>
        <div class="experience-image-wrapper">
            <img src="/images/cinema_experience.jpg" alt="Không gian rạp chiếu phim hiện đại CINEVIBE" class="experience-image" loading="lazy">
        </div>
    </section>

    <!-- ============================================================== -->
    <!-- SECTION 5 — CALL TO ACTION (CTA BOX)                           -->
    <!-- ============================================================== -->
    <section class="about-cta-card">
        <div style="color: var(--color-gold); font-size: 2.2rem; margin-bottom: 1rem;">
            <i class="fas fa-film"></i>
        </div>
        <h2 class="about-cta-title">Sẵn Sàng Cho Suất Chiếu Tiếp Theo?</h2>
        <p class="about-cta-desc">
            Khám phá những bộ phim đang chiếu và lựa chọn suất chiếu phù hợp với bạn.
        </p>
        <a href="/movies" class="btn btn-primary btn-lg" style="box-shadow: 0 0 25px var(--color-primary-glow);">
            <i class="fas fa-clapperboard"></i> Khám Phá Phim Ngay <i class="fas fa-arrow-right" style="margin-left: 0.35rem;"></i>
        </a>
    </section>
</main>

<%- include('partials/footer') %>
