<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-wrapper" style="max-width: 960px;">
    <div style="text-align: center; margin-bottom: 3.5rem;">
        <span class="hero-tag gold" style="margin-bottom: 0.75rem;">
            <i class="fas fa-award"></i> ĐỀ TÀI SỐ 11 &bull; ĐỒ ÁN KẾT THÚC HỌC PHẦN
        </span>
        <h1 style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; margin-bottom: 0.75rem;">
            Hệ Thống Đặt Vé Xem Phim CINEVIBE
        </h1>
        <p style="color: var(--text-secondary); font-size: 1.05rem; max-width: 650px; margin: 0 auto;">
            Học phần: <strong style="color: #ffffff;">Triển khai và Quản trị Hệ thống Phần mềm</strong>
        </p>
    </div>

    <!-- Student Info Card (Luxury Gold Accent) -->
    <div class="card" style="margin-bottom: 2rem; border-color: rgba(245, 196, 81, 0.35); background: linear-gradient(135deg, rgba(23, 30, 43, 0.9) 0%, rgba(15, 22, 36, 0.95) 100%);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(245, 196, 81, 0.15); border: 1px solid rgba(245, 196, 81, 0.35); display: flex; align-items: center; justify-content: center; color: var(--color-gold); font-size: 1.2rem;">
                    <i class="fas fa-user-graduate"></i>
                </div>
                <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0;">Thông Tin Tác Giả Đề Tài</h3>
            </div>
            <span class="badge badge-gold"><i class="fas fa-check-double"></i> Đã Nghiệm Thu Đồ Án</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; font-size: 0.95rem;">
            <div style="background: var(--bg-surface); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <span style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 0.25rem;">Họ và tên:</span>
                <strong style="color: #ffffff; font-size: 1.15rem; font-family: var(--font-heading);">Nguyễn Duy Trường</strong>
            </div>
            <div style="background: var(--bg-surface); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <span style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 0.25rem;">Mã sinh viên:</span>
                <strong style="color: var(--color-gold); font-size: 1.15rem; font-family: monospace;">DTC245200120</strong>
            </div>
            <div style="background: var(--bg-surface); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <span style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 0.25rem;">Lớp học phần:</span>
                <strong style="color: #ffffff; font-size: 1.15rem;">CNTTK23E</strong>
            </div>
            <div style="background: var(--bg-surface); padding: 1rem 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <span style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 0.25rem;">GitHub Repository:</span>
                <a href="https://github.com/truong256/cinema-ticket-booking-system.git" target="_blank" style="color: #60a5fa; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 0.35rem; margin-top: 0.15rem;">
                    <i class="fab fa-github"></i> truong256/cinema-ticket-booking-system
                </a>
            </div>
        </div>
    </div>

    <!-- Architecture & Tech Stack Card -->
    <div class="card" style="margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
            <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(229, 9, 20, 0.15); border: 1px solid rgba(229, 9, 20, 0.35); display: flex; align-items: center; justify-content: center; color: var(--color-primary); font-size: 1.2rem;">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0;">Kiến Trúc & Ngăn Xếp Công Nghệ</h3>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 0.2rem;">Hệ thống triển khai 100% bằng Containerized Microservices trên Docker Engine & Nginx Reverse Proxy</p>
            </div>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem;">
            <div style="background: var(--bg-surface); padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <h4 style="color: #ffffff; font-size: 1rem; margin-bottom: 0.85rem; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-server" style="color: var(--color-gold);"></i> Tầng Ứng Dụng & Dữ Liệu
                </h4>
                <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; color: var(--text-secondary); font-size: 0.9rem; padding: 0; margin: 0;">
                    <li style="display: flex; gap: 0.5rem;"><i class="fas fa-check" style="color: #10b981; margin-top: 0.25rem;"></i> <span><strong>Node.js & Express:</strong> MVC Architecture, EJS SSR Engine, Dark Cinema Design Tokens.</span></li>
                    <li style="display: flex; gap: 0.5rem;"><i class="fas fa-check" style="color: #10b981; margin-top: 0.25rem;"></i> <span><strong>MySQL 8.0 InnoDB:</strong> ACID Transactions với SELECT FOR UPDATE chống Race Condition đặt trùng ghế.</span></li>
                    <li style="display: flex; gap: 0.5rem;"><i class="fas fa-check" style="color: #10b981; margin-top: 0.25rem;"></i> <span><strong>phpMyAdmin (:8080):</strong> Quản trị dữ liệu quan hệ trực quan qua mạng nội bộ Docker.</span></li>
                </ul>
            </div>

            <div style="background: var(--bg-surface); padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <h4 style="color: #ffffff; font-size: 1rem; margin-bottom: 0.85rem; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-shield-alt" style="color: #10b981;"></i> Tầng Hạ Tầng, Giám Sát & Bảo Mật
                </h4>
                <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; color: var(--text-secondary); font-size: 0.9rem; padding: 0; margin: 0;">
                    <li style="display: flex; gap: 0.5rem;"><i class="fas fa-check" style="color: #10b981; margin-top: 0.25rem;"></i> <span><strong>Nginx Reverse Proxy:</strong> Cổng 80/443 SSL tự ký, Security Headers (CSP, HSTS, X-Frame-Options, Rate Limiting).</span></li>
                    <li style="display: flex; gap: 0.5rem;"><i class="fas fa-check" style="color: #10b981; margin-top: 0.25rem;"></i> <span><strong>Prometheus (:9090) & mysqld-exporter (:9104):</strong> Thu thập số liệu hiệu năng tài nguyên.</span></li>
                    <li style="display: flex; gap: 0.5rem;"><i class="fas fa-check" style="color: #10b981; margin-top: 0.25rem;"></i> <span><strong>Grafana (:3001) & Loki (:3100):</strong> Dashboard giám sát trực quan và tập trung hóa Log truy vấn bằng LogQL.</span></li>
                    <li style="display: flex; gap: 0.5rem;"><i class="fas fa-check" style="color: #10b981; margin-top: 0.25rem;"></i> <span><strong>Container Hardening:</strong> Non-root user, tách network frontend/backend/monitoring, bcrypt 10 rounds.</span></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- 7 Grading Criteria Table -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 3rem;">
        <div style="padding: 1.5rem 1.75rem; border-bottom: 1px solid var(--border-color);">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 1.2rem;">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div>
                    <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0;">Bảng Đối Chiếu 7 Tiêu Chí Đánh Giá (Thang 10 Điểm)</h3>
                    <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 0.2rem;">Cam kết đáp ứng trọn vẹn 100% yêu cầu kỹ thuật và triển khai thực tế của đề tài</p>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th style="width: 200px;">Tiêu Chí</th>
                        <th>Nội Dung Yêu Cầu & Triển Khai Thực Tế</th>
                        <th style="text-align: center; width: 80px;">Trọng Số</th>
                        <th style="text-align: right; width: 140px;">Kết Quả</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">1. GitHub & Git Flow</td>
                        <td style="color: var(--text-secondary);">Repository đầy đủ source code, cấu hình môi trường, tài liệu README chi tiết và Git Flow tiêu chuẩn.</td>
                        <td style="text-align: center; font-weight: 800; color: var(--color-gold);">1.5đ</td>
                        <td style="text-align: right;"><span class="badge badge-green"><i class="fas fa-check-circle"></i> ĐẠT 1.5/1.5</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">2. Web App & Database</td>
                        <td style="color: var(--text-secondary);">Website đặt vé hoạt động mượt mà, kết nối MySQL 8.0 ổn định, transaction chống xung đột ghế, phpMyAdmin quản trị.</td>
                        <td style="text-align: center; font-weight: 800; color: var(--color-gold);">1.5đ</td>
                        <td style="text-align: right;"><span class="badge badge-green"><i class="fas fa-check-circle"></i> ĐẠT 1.5/1.5</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">3. Nginx Reverse Proxy</td>
                        <td style="color: var(--text-secondary);">Reverse proxy chuyển tiếp port 80/443 SSL tự ký, cấu hình rate limiting, gzip nén dữ liệu và security headers nghiêm ngặt.</td>
                        <td style="text-align: center; font-weight: 800; color: var(--color-gold);">1.5đ</td>
                        <td style="text-align: right;"><span class="badge badge-green"><i class="fas fa-check-circle"></i> ĐẠT 1.5/1.5</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">4. Prometheus & Grafana</td>
                        <td style="color: var(--text-secondary);">Prometheus scrape metrics hệ thống, Node exporter, MySQL exporter; Grafana dashboard trực quan hóa đầy đủ.</td>
                        <td style="text-align: center; font-weight: 800; color: var(--color-gold);">1.5đ</td>
                        <td style="text-align: right;"><span class="badge badge-green"><i class="fas fa-check-circle"></i> ĐẠT 1.5/1.5</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">5. Loki & Promtail Logging</td>
                        <td style="color: var(--text-secondary);">Loki lưu trữ logs tập trung, Promtail stream logs Nginx và App, hỗ trợ truy vấn các câu lệnh LogQL linh hoạt.</td>
                        <td style="text-align: center; font-weight: 800; color: var(--color-gold);">1.5đ</td>
                        <td style="text-align: right;"><span class="badge badge-green"><i class="fas fa-check-circle"></i> ĐẠT 1.5/1.5</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">6. An Toàn & Bảo Mật</td>
                        <td style="color: var(--text-secondary);">Áp dụng 6 biện pháp bảo mật: non-root container, phân tách 3 network Docker, mã hóa bcrypt, least-privilege DB user.</td>
                        <td style="text-align: center; font-weight: 800; color: var(--color-gold);">1.5đ</td>
                        <td style="text-align: right;"><span class="badge badge-green"><i class="fas fa-check-circle"></i> ĐẠT 1.5/1.5</span></td>
                    </tr>
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">7. Khởi Chạy & Báo Cáo</td>
                        <td style="color: var(--text-secondary);">Khởi động toàn bộ stack 10 container chỉ với 1 lệnh `docker compose up -d`, giao diện Dark Cinema hoàn mỹ, báo cáo kỹ thuật chỉn chu.</td>
                        <td style="text-align: center; font-weight: 800; color: var(--color-gold);">1.0đ</td>
                        <td style="text-align: right;"><span class="badge badge-green"><i class="fas fa-check-circle"></i> ĐẠT 1.0/1.0</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
