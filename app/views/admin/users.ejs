<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <!-- Header -->
    <div class="section-header">
        <div>
            <a href="/admin" style="color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.4rem;">
                &larr; Quay lại Dashboard
            </a>
            <h1 class="section-title">Quản Lý Khách Hàng & Người Dùng</h1>
            <p class="section-subtitle">Danh sách tài khoản, giám sát hành vi, thống kê chi tiêu và phân quyền hệ thống</p>
        </div>
    </div>

    <!-- Admin Navigation Tabs -->
    <div style="display: flex; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <a href="/admin" class="btn btn-secondary btn-sm">Dashboard</a>
        <a href="/admin/movies" class="btn btn-secondary btn-sm">Phim</a>
        <a href="/admin/showtimes" class="btn btn-secondary btn-sm">Suất chiếu</a>
        <a href="/admin/cinemas" class="btn btn-secondary btn-sm">Cụm rạp</a>
        <a href="/admin/rooms" class="btn btn-secondary btn-sm">Phòng & Ghế</a>
        <a href="/admin/bookings" class="btn btn-secondary btn-sm">Đơn đặt vé</a>
        <a href="/admin/users" class="btn btn-primary btn-sm">Khách hàng</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem;"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem;"><%= success %></div>
    <% } %>

    <!-- Search Form -->
    <div class="card" style="padding: 1.25rem 1.5rem; margin-bottom: 1.75rem;">
        <form action="/admin/users" method="GET" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <input type="text" name="search" class="form-control" value="<%= search || '' %>" placeholder="Tìm theo tên đăng nhập, email, họ tên, SĐT..." style="flex: 1; min-width: 250px;">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <% if (search) { %>
                <a href="/admin/users" class="btn btn-secondary">Đặt lại</a>
            <% } %>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2.5rem;">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Họ Và Tên</th>
                        <th>Email & Số Điện Thoại</th>
                        <th>Vai Trò</th>
                        <th>Số Đơn Đặt Vé</th>
                        <th>Tổng Chi Tiêu</th>
                        <th>Trạng Thái</th>
                        <th style="text-align: right;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users && users.length > 0) { %>
                        <% users.forEach(u => { %>
                            <tr>
                                <td style="color: var(--text-muted); font-weight: 600;">#<%= u.id %></td>
                                <td>
                                    <strong style="color: #FFFFFF; font-family: var(--font-mono);"><%= u.username %></strong>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: #FFFFFF;"><%= u.full_name %></div>
                                    <div style="font-size: 0.78rem; color: var(--text-muted);">
                                        Tạo: <%= new Date(u.created_at).toLocaleDateString('vi-VN') %>
                                    </div>
                                </td>
                                <td>
                                    <div style="color: var(--text-secondary); font-size: 0.88rem;"><%= u.email %></div>
                                    <div style="color: var(--text-muted); font-size: 0.82rem; margin-top: 0.15rem;"><%= u.phone || 'Chưa cập nhật' %></div>
                                </td>
                                <td>
                                    <% if (u.role === 'admin') { %>
                                        <span class="badge badge-gold">Quản trị viên</span>
                                    <% } else { %>
                                        <span class="badge badge-blue">Khách hàng</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #FFFFFF;"><%= u.booking_count %> đơn</span>
                                </td>
                                <td>
                                    <span style="font-weight: 800; color: var(--color-gold);">
                                        <%= Number(u.total_spent).toLocaleString('vi-VN') %> đ
                                    </span>
                                </td>
                                <td>
                                    <% if (u.status === 'locked') { %>
                                        <span class="badge badge-red">ĐÃ KHÓA</span>
                                    <% } else { %>
                                        <span class="badge badge-green">HOẠT ĐỘNG</span>
                                    <% } %>
                                </td>
                                <td style="text-align: right;">
                                    <% if (u.role !== 'admin') { %>
                                        <form action="/admin/users/<%= u.id %>/toggle-lock" method="POST" style="display: inline-block;" onsubmit="return confirm('Bạn có chắc chắn muốn <%= u.status === 'locked' ? 'MỞ KHÓA' : 'TẠM KHÓA' %> tài khoản <%= u.username %>?')">
                                            <button type="submit" class="btn <%= u.status === 'locked' ? 'btn-primary' : 'btn-danger' %> btn-sm">
                                                <%= u.status === 'locked' ? 'Mở khóa' : 'Khóa nick' %>
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span style="font-size: 0.78rem; color: var(--text-muted);">Không thể khóa</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                                Không tìm thấy người dùng nào phù hợp với từ khóa tìm kiếm.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
