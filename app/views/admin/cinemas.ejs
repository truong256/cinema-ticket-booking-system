<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <div class="section-header">
        <div>
            <a href="/admin" style="color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.4rem;">
                &larr; Quay lại Dashboard
            </a>
            <h1 class="section-title">Quản Lý Cụm Rạp Chiếu Phim</h1>
            <p class="section-subtitle">Danh sách các cơ sở rạp, địa chỉ hoạt động và phân bổ các phòng chiếu phim</p>
        </div>
        <button class="btn btn-primary" onclick="document.getElementById('modalAddCinema').style.display='flex'">
            Thêm cụm rạp mới
        </button>
    </div>

    <!-- Admin Navigation Tabs -->
    <div style="display: flex; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <a href="/admin" class="btn btn-secondary btn-sm">Dashboard</a>
        <a href="/admin/movies" class="btn btn-secondary btn-sm">Phim</a>
        <a href="/admin/showtimes" class="btn btn-secondary btn-sm">Suất chiếu</a>
        <a href="/admin/cinemas" class="btn btn-primary btn-sm">Cụm rạp</a>
        <a href="/admin/rooms" class="btn btn-secondary btn-sm">Phòng & Ghế</a>
        <a href="/admin/bookings" class="btn btn-secondary btn-sm">Đơn đặt vé</a>
        <a href="/admin/users" class="btn btn-secondary btn-sm">Khách hàng</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem;"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem;"><%= success %></div>
    <% } %>

    <!-- Cinemas Table -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2.5rem;">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tên Cụm Rạp</th>
                        <th>Địa Chỉ</th>
                        <th>Thành Phố</th>
                        <th>Hotline</th>
                        <th>Số Phòng</th>
                        <th>Trạng Thái</th>
                        <th style="text-align: right;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (cinemas && cinemas.length > 0) { %>
                        <% cinemas.forEach(c => { %>
                            <tr>
                                <td style="color: var(--text-muted); font-weight: 600;">#<%= c.id %></td>
                                <td>
                                    <strong style="color: #FFFFFF; font-size: 1rem;"><%= c.name %></strong>
                                </td>
                                <td style="color: var(--text-secondary);"><%= c.address %></td>
                                <td><span class="badge badge-blue"><%= c.city %></span></td>
                                <td style="color: var(--color-gold); font-family: var(--font-mono);"><%= c.phone || 'N/A' %></td>
                                <td>
                                    <a href="/admin/rooms" style="color: var(--color-gold); font-weight: 700; text-decoration: underline;">
                                        <%= c.room_count %> phòng
                                    </a>
                                </td>
                                <td>
                                    <% if (c.is_active) { %>
                                        <span class="badge badge-green">Hoạt động</span>
                                    <% } else { %>
                                        <span class="badge badge-red">Tạm dừng</span>
                                    <% } %>
                                </td>
                                <td style="text-align: right;">
                                    <form action="/admin/cinemas/<%= c.id %>/toggle" method="POST" style="display: inline-block;">
                                        <button type="submit" class="btn btn-secondary btn-sm" title="Bật/Tắt hoạt động">
                                            <%= c.is_active ? 'Tạm ngưng' : 'Mở lại' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                                Chưa có cụm rạp nào trong hệ thống.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Thêm Rạp Chiếu -->
    <div id="modalAddCinema" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 9999; justify-content: center; align-items: center; padding: 1.5rem;">
        <div class="card" style="max-width: 500px; width: 100%; padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-color);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <h3 style="color: #FFFFFF; font-size: 1.25rem;">Thêm Cụm Rạp Mới</h3>
                <button type="button" onclick="document.getElementById('modalAddCinema').style.display='none'" style="background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>

            <form action="/admin/cinemas/create" method="POST">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" style="display: block; color: var(--text-secondary); margin-bottom: 0.4rem; font-size: 0.88rem;">Tên Cụm Rạp *</label>
                    <input type="text" name="name" class="form-control" required placeholder="Ví dụ: CineVibe Royal City">
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" style="display: block; color: var(--text-secondary); margin-bottom: 0.4rem; font-size: 0.88rem;">Địa Chỉ Cơ Sở *</label>
                    <input type="text" name="address" class="form-control" required placeholder="Ví dụ: 72A Nguyễn Trãi, Thanh Xuân">
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" style="display: block; color: var(--text-secondary); margin-bottom: 0.4rem; font-size: 0.88rem;">Thành Phố</label>
                    <input type="text" name="city" class="form-control" value="Hà Nội" placeholder="Hà Nội, TP.HCM,...">
                </div>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label class="form-label" style="display: block; color: var(--text-secondary); margin-bottom: 0.4rem; font-size: 0.88rem;">Số Điện Thoại Hotline</label>
                    <input type="text" name="phone" class="form-control" placeholder="1900xxxx">
                </div>

                <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                    <button type="button" onclick="document.getElementById('modalAddCinema').style.display='none'" class="btn btn-secondary">Hủy</button>
                    <button type="submit" class="btn btn-primary">Xác Nhận Tạo Rạp</button>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
