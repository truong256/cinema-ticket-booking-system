<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper" style="max-width: 1050px;">
    <!-- Page Header -->
    <div class="section-header">
        <div>
            <a href="/admin/rooms" style="color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.4rem;">
                &larr; Quay lại Danh sách Phòng
            </a>
            <h1 class="section-title">
                Sơ Đồ Ghế & Bảo Trì: <%= room.name %>
            </h1>
            <p class="section-subtitle">
                Cụm rạp: <strong style="color: #FFFFFF;"><%= room.cinema_name %></strong> &bull; Định dạng: <span class="badge badge-gold"><%= room.room_type %></span>
            </p>
        </div>

        <div style="text-align: right;">
            <span style="font-size: 0.85rem; color: var(--text-muted); display: block;">Tổng số ghế:</span>
            <strong style="font-size: 1.25rem; color: #FFFFFF;"><%= totalSeats %> ghế (<%= lockedCount %> đang khóa)</strong>
        </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.75rem;"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" style="margin-bottom: 1.75rem;"><%= success %></div>
    <% } %>

    <!-- Legend -->
    <div class="card" style="padding: 1rem 1.5rem; margin-bottom: 2rem; background: var(--bg-surface); border-color: var(--border-color);">
        <div style="display: flex; gap: 1.5rem; justify-content: center; align-items: center; flex-wrap: wrap; font-size: 0.88rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 22px; height: 22px; border-radius: 4px; background: #1E293B; border: 1px solid #475569;"></div>
                <span style="color: var(--text-secondary);">Thường (Regular)</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 22px; height: 22px; border-radius: 4px; background: rgba(245, 196, 81, 0.2); border: 1px solid var(--color-gold);"></div>
                <span style="color: var(--color-gold);">VIP (Ghế Đẹp)</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 32px; height: 22px; border-radius: 4px; background: rgba(236, 72, 153, 0.2); border: 1px solid #EC4899;"></div>
                <span style="color: #F472B6;">Ghế Đôi (Couple)</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 22px; height: 22px; border-radius: 4px; background: rgba(239, 68, 68, 0.25); border: 1px dashed #EF4444; color: #EF4444; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: bold;">✕</div>
                <span style="color: #F87171;">Tạm Khóa (Bảo trì)</span>
            </div>
        </div>
    </div>

    <!-- Cinema Screen Curve Indicator -->
    <div class="screen-container" style="text-align: center; margin-bottom: 3rem;">
        <div style="width: 75%; height: 6px; background: linear-gradient(90deg, transparent, var(--color-gold), transparent); border-radius: 50%; margin: 0 auto 0.75rem; box-shadow: 0 0 15px rgba(245, 196, 81, 0.5);"></div>
        <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px;">MÀN HÌNH CHIẾU PHIM</span>
    </div>

    <!-- Interactive Seat Grid -->
    <div class="card" style="padding: 2.5rem 1.5rem; background: #0E1422; border: 1px solid var(--border-color); overflow-x: auto; margin-bottom: 2rem;">
        <div style="display: flex; flex-direction: column; gap: 0.85rem; min-width: 650px; align-items: center;">
            <% Object.keys(seatRows).sort().forEach(rowLabel => { %>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <!-- Row Label Left -->
                    <span style="width: 28px; font-weight: 800; color: var(--color-gold); text-align: center; font-family: var(--font-mono);">
                        <%= rowLabel %>
                    </span>

                    <!-- Row Seats -->
                    <div style="display: flex; gap: 0.5rem;">
                        <% seatRows[rowLabel].forEach(s => { %>
                            <form action="/admin/seats/<%= s.id %>/toggle" method="POST" style="margin: 0;" onsubmit="return confirm('Bạn có chắc chắn muốn <%= s.is_active ? 'TẠM KHÓA' : 'MỞ KHÓA' %> ghế <%= s.row_label %><%= s.seat_number %>?')">
                                <button type="submit" 
                                    title="Nhấn để <%= s.is_active ? 'Khóa bảo trì' : 'Mở hoạt động' %> ghế <%= s.row_label %><%= s.seat_number %> (<%= s.seat_type %>)"
                                    style="
                                        width: <%= s.seat_type === 'Couple' ? '54px' : '36px' %>;
                                        height: 36px;
                                        border-radius: 6px;
                                        border: <%= s.is_active ? (s.seat_type === 'VIP' ? '1px solid #F5C451' : (s.seat_type === 'Couple' ? '1px solid #EC4899' : '1px solid #475569')) : '1px dashed #EF4444' %>;
                                        background: <%= s.is_active ? (s.seat_type === 'VIP' ? 'rgba(245, 196, 81, 0.15)' : (s.seat_type === 'Couple' ? 'rgba(236, 72, 153, 0.15)' : '#1E293B')) : 'rgba(239, 68, 68, 0.2)' %>;
                                        color: <%= s.is_active ? (s.seat_type === 'VIP' ? '#F5C451' : (s.seat_type === 'Couple' ? '#F472B6' : '#94A3B8')) : '#EF4444' %>;
                                        cursor: pointer;
                                        font-family: var(--font-mono);
                                        font-size: 0.75rem;
                                        font-weight: 700;
                                        display: flex;
                                        flex-direction: column;
                                        align-items: center;
                                        justify-content: center;
                                        transition: transform 0.15s ease, background 0.15s ease;
                                    "
                                    onmouseover="this.style.transform='scale(1.1)'"
                                    onmouseout="this.style.transform='scale(1)'"
                                >
                                    <span><%= s.seat_number %></span>
                                    <span style="font-size: 0.55rem; opacity: 0.8;"><%= s.is_active ? s.seat_type.substring(0, 3) : 'LOCKED' %></span>
                                </button>
                            </form>
                        <% }); %>
                    </div>

                    <!-- Row Label Right -->
                    <span style="width: 28px; font-weight: 800; color: var(--color-gold); text-align: center; font-family: var(--font-mono);">
                        <%= rowLabel %>
                    </span>
                </div>
            <% }); %>
        </div>
    </div>

    <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.25rem; font-size: 0.85rem; color: var(--text-secondary); text-align: center;">
        Hướng dẫn: Nhấp chuột vào bất kỳ ghế nào trên sơ đồ để <strong style="color: #EF4444;">Tạm Khóa (bảo trì ghế hỏng)</strong> hoặc <strong style="color: #10B981;">Mở lại</strong>. Ghế bị khóa sẽ tự động ẩn khỏi giao diện chọn ghế của khách hàng và được bảo vệ không thể đặt vé.
    </div>
</main>

<%- include('../partials/footer') %>
