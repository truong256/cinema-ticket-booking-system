<%- include('partials/admin_header', { title: 'Sơ Đồ Ghế - ' + room.name + ' - CineVibe' }) %>
<%- include('partials/admin_sidebar', { activeTab: 'seats' }) %>

<main class="admin-main-wrapper">
    <%- include('partials/admin_topbar', { 
        pageTitle: 'Sơ đồ ghế: ' + room.name, 
        pageSubtitle: room.cinema_name + ' • Định dạng: ' + room.room_type 
    }) %>

    <div class="admin-content" style="max-width: 1050px; margin: 0 auto; width: 100%;">
        <div style="margin-bottom: 1.25rem;">
            <a href="/admin/rooms" class="admin-btn admin-btn-secondary admin-btn-sm">
                Quay lại danh sách phòng
            </a>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="admin-alert admin-alert-danger"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="admin-alert admin-alert-success"><%= success %></div>
        <% } %>

        <!-- Seat Statistics Bar -->
        <div class="admin-card" style="padding: 1rem 1.5rem; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <span style="font-size: 0.8rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Phòng chiếu</span>
                    <div style="font-size: 1.1rem; font-weight: 700; color: #FFFFFF;"><%= room.name %> (<%= room.cinema_name %>)</div>
                </div>
                <div>
                    <span class="admin-pill-badge">Tổng số: <%= totalSeats %> ghế</span>
                    <span class="admin-pill-badge" style="color: <%= lockedCount > 0 ? '#F87171' : 'var(--admin-text-secondary)' %>;">
                        <%= lockedCount %> đang khóa
                    </span>
                </div>
            </div>
        </div>

        <!-- Legend (Zero Icons, Text-First) -->
        <div class="admin-card" style="padding: 1rem 1.5rem; margin-bottom: 2rem; background: var(--admin-bg-surface);">
            <div style="display: flex; gap: 1.5rem; justify-content: center; align-items: center; flex-wrap: wrap; font-size: 0.84rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div style="width: 20px; height: 20px; border-radius: 4px; background: #1E293B; border: 1px solid #475569;"></div>
                    <span style="color: var(--admin-text-secondary);">Thường (Regular)</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div style="width: 20px; height: 20px; border-radius: 4px; background: rgba(245, 196, 81, 0.15); border: 1px solid var(--admin-accent-gold);"></div>
                    <span style="color: var(--admin-accent-gold);">VIP (Hàng giữa)</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div style="width: 32px; height: 20px; border-radius: 4px; background: rgba(236, 72, 153, 0.15); border: 1px solid #EC4899;"></div>
                    <span style="color: #F472B6;">Ghế Đôi (Couple)</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div style="width: 20px; height: 20px; border-radius: 4px; background: rgba(239, 68, 68, 0.2); border: 1px dashed #EF4444; color: #EF4444; font-size: 0.65rem; font-weight: bold; display: flex; align-items: center; justify-content: center;">KHOA</div>
                    <span style="color: #F87171;">Tạm khóa (Bảo trì)</span>
                </div>
            </div>
        </div>

        <!-- Curved Cinema Screen -->
        <div style="text-align: center; margin-bottom: 2.5rem;">
            <div style="width: 70%; height: 5px; background: linear-gradient(90deg, transparent, var(--admin-accent-gold), transparent); border-radius: 50%; margin: 0 auto 0.6rem; box-shadow: 0 0 12px rgba(245, 196, 81, 0.4);"></div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted); text-transform: uppercase; letter-spacing: 2px; font-weight: 700;">MÀN HÌNH CHIẾU PHIM</span>
        </div>

        <!-- Interactive Seat Grid -->
        <div class="admin-card" style="padding: 2.5rem 1.5rem; background: #0E1422; overflow-x: auto; margin-bottom: 1.5rem;">
            <div style="display: flex; flex-direction: column; gap: 0.85rem; min-width: 650px; align-items: center;">
                <% Object.keys(seatRows).sort().forEach(rowLabel => { %>
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <span style="width: 28px; font-weight: 800; color: var(--admin-accent-gold); text-align: center; font-family: 'JetBrains Mono', monospace;">
                            <%= rowLabel %>
                        </span>

                        <div style="display: flex; gap: 0.5rem;">
                            <% seatRows[rowLabel].forEach(s => { %>
                                <form action="/admin/seats/<%= s.id %>/toggle" method="POST" style="margin: 0;" onsubmit="return confirm('Bạn có chắc chắn muốn <%= s.is_active ? 'TẠM KHÓA' : 'MỞ KHÓA' %> ghế <%= s.row_label %><%= s.seat_number %>?')">
                                    <button type="submit" 
                                        title="Nhấn để <%= s.is_active ? 'Khóa bảo trì' : 'Mở hoạt động' %> ghế <%= s.row_label %><%= s.seat_number %> (<%= s.seat_type %>)"
                                        style="
                                            width: <%= s.seat_type === 'Couple' ? '54px' : '36px' %>;
                                            height: 36px;
                                            border-radius: 6px;
                                            border: <%= s.is_active ? (s.seat_type === 'VIP' ? '1px solid #F5C451' : (s.seat_type === 'Couple' ? '1px solid #EC4899' : '1px solid #475569')) : '1px dashed #EF4444' %>;
                                            background: <%= s.is_active ? (s.seat_type === 'VIP' ? 'rgba(245, 196, 81, 0.15)' : (s.seat_type === 'Couple' ? 'rgba(236, 72, 153, 0.15)' : '#1E293B')) : 'rgba(239, 68, 68, 0.2)' %>;
                                            color: <%= s.is_active ? (s.seat_type === 'VIP' ? '#F5C451' : (s.seat_type === 'Couple' ? '#F472B6' : '#94A3B8')) : '#EF4444' %>;
                                            cursor: pointer;
                                            font-family: 'JetBrains Mono', monospace;
                                            font-size: 0.75rem;
                                            font-weight: 700;
                                            display: flex;
                                            flex-direction: column;
                                            align-items: center;
                                            justify-content: center;
                                            transition: transform 0.15s ease, background 0.15s ease;
                                        "
                                        onmouseover="this.style.transform='scale(1.08)'"
                                        onmouseout="this.style.transform='scale(1)'"
                                    >
                                        <span><%= s.seat_number %></span>
                                        <span style="font-size: 0.55rem; opacity: 0.85;"><%= s.is_active ? s.seat_type.substring(0, 3) : 'KHOA' %></span>
                                    </button>
                                </form>
                            <% }); %>
                        </div>

                        <span style="width: 28px; font-weight: 800; color: var(--admin-accent-gold); text-align: center; font-family: 'JetBrains Mono', monospace;">
                            <%= rowLabel %>
                        </span>
                    </div>
                <% }); %>
            </div>
        </div>

        <div class="admin-card" style="padding: 1rem 1.25rem; font-size: 0.82rem; color: var(--admin-text-secondary); text-align: center; background: var(--admin-bg-surface);">
            Hướng dẫn: Nhấp chuột vào bất kỳ ghế nào trên sơ đồ để <strong style="color: #F87171;">Tạm khóa (bảo trì)</strong> hoặc <strong style="color: #34D399;">Mở lại</strong>. Ghế bị khóa sẽ tự động ẩn khỏi giao diện chọn ghế của khách hàng và được bảo vệ không thể đặt vé.
        </div>
    </div>
</main>

<%- include('partials/admin_footer') %>
