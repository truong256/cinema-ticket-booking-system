<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <div class="section-header">
        <div>
            <a href="/admin" style="color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.4rem;">
                &larr; Quay lại Dashboard
            </a>
            <h1 class="section-title">Quản Lý Phòng Chiếu & Ghế Ngồi</h1>
            <p class="section-subtitle">Danh sách các phòng chiếu, định dạng phòng Standard/VIP/IMAX và sơ đồ ghế tương ứng</p>
        </div>
        <button class="btn btn-primary" onclick="document.getElementById('modalAddRoom').style.display='flex'">
            Thêm phòng chiếu mới
        </button>
    </div>

    <!-- Admin Navigation Tabs -->
    <div style="display: flex; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <a href="/admin" class="btn btn-secondary btn-sm">Dashboard</a>
        <a href="/admin/movies" class="btn btn-secondary btn-sm">Phim</a>
        <a href="/admin/showtimes" class="btn btn-secondary btn-sm">Suất chiếu</a>
        <a href="/admin/cinemas" class="btn btn-secondary btn-sm">Cụm rạp</a>
        <a href="/admin/rooms" class="btn btn-primary btn-sm">Phòng & Ghế</a>
        <a href="/admin/bookings" class="btn btn-secondary btn-sm">Đơn đặt vé</a>
        <a href="/admin/users" class="btn btn-secondary btn-sm">Khách hàng</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem;"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem;"><%= success %></div>
    <% } %>

    <!-- Rooms Table -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2.5rem;">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Cụm Rạp</th>
                        <th>Tên Phòng Chiếu</th>
                        <th>Định Dạng</th>
                        <th>Tổng Ghế Thực Tế</th>
                        <th>Ghế Bị Khóa</th>
                        <th>Trạng Thái</th>
                        <th style="text-align: right;">Sơ Đồ Ghế</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (rooms && rooms.length > 0) { %>
                        <% rooms.forEach(r => { %>
                            <tr>
                                <td style="color: var(--text-muted); font-weight: 600;">#<%= r.id %></td>
                                <td>
                                    <strong style="color: #FFFFFF;"><%= r.cinema_name %></strong>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: var(--color-gold); font-size: 1rem;"><%= r.name %></span>
                                </td>
                                <td>
                                    <span class="badge <%= r.room_type === 'IMAX' ? 'badge-gold' : (r.room_type === 'VIP' ? 'badge-green' : 'badge-blue') %>">
                                        <%= r.room_type %>
                                    </span>
                                </td>
                                <td>
                                    <span style="font-weight: 700; color: #FFFFFF;"><%= r.actual_seats || r.total_seats %> ghế</span>
                                </td>
                                <td>
                                    <% if (r.locked_seats > 0) { %>
                                        <span class="badge badge-red"><%= r.locked_seats %> ghế khóa</span>
                                    <% } else { %>
                                        <span style="color: var(--text-muted); font-size: 0.85rem;">0 ghế</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (r.is_active) { %>
                                        <span class="badge badge-green">Hoạt động</span>
                                    <% } else { %>
                                        <span class="badge badge-red">Ngừng dùng</span>
                                    <% } %>
                                </td>
                                <td style="text-align: right;">
                                    <a href="/admin/rooms/<%= r.id %>/seats" class="btn btn-secondary btn-sm" title="Xem sơ đồ & khóa/mở khóa ghế">
                                        Quản lý sơ đồ ghế &rarr;
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                                Chưa có phòng chiếu nào. Hãy tạo phòng mới!
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Thêm Phòng Chiếu -->
    <div id="modalAddRoom" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 9999; justify-content: center; align-items: center; padding: 1.5rem;">
        <div class="card" style="max-width: 520px; width: 100%; padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-color);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <h3 style="color: #FFFFFF; font-size: 1.25rem;">Thêm Phòng Chiếu & Tạo Ghế Tự Động</h3>
                <button type="button" onclick="document.getElementById('modalAddRoom').style.display='none'" style="background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>

            <form action="/admin/rooms/create" method="POST">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" style="display: block; color: var(--text-secondary); margin-bottom: 0.4rem; font-size: 0.88rem;">Chọn Cụm Rạp *</label>
                    <select name="cinema_id" class="form-control" required>
                        <% if (cinemas && cinemas.length > 0) { %>
                            <% cinemas.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label" style="display: block; color: var(--text-secondary); margin-bottom: 0.4rem; font-size: 0.88rem;">Tên Phòng Chiếu *</label>
                    <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Phòng 04 - IMAX Laser">
                </div>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label class="form-label" style="display: block; color: var(--text-secondary); margin-bottom: 0.4rem; font-size: 0.88rem;">Loại Phòng Chiếu</label>
                    <select name="room_type" class="form-control">
                        <option value="Standard">Standard (Chuẩn)</option>
                        <option value="VIP">VIP (Ghế Sofa Da Cao Cấp)</option>
                        <option value="IMAX">IMAX (Màn Chiếu Laser Siêu Rộng)</option>
                    </select>
                    <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem; display: block;">
                        Hệ thống sẽ tự động khởi tạo ma trận 60 ghế (Hàng A-B: Thường, C-E: VIP, F: Đôi)
                    </span>
                </div>

                <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                    <button type="button" onclick="document.getElementById('modalAddRoom').style.display='none'" class="btn btn-secondary">Hủy</button>
                    <button type="submit" class="btn btn-primary">Khởi Tạo Phòng Chiếu</button>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
