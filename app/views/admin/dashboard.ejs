<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <!-- Admin Header -->
    <div class="section-header">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                <span class="brand-badge gold"><i class="fas fa-shield-halved"></i> QUẢN TRỊ VIÊN</span>
                <span style="font-size: 0.85rem; color: var(--text-muted);">Đề 11 - Phân Hệ Quản Trị Hệ Thống</span>
            </div>
            <h1 class="section-title">
                <i class="fas fa-gauge-high"></i> Bảng Điều Khiển Quản Trị
            </h1>
        </div>

        <!-- Navigation Buttons -->
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/admin/movies" class="btn btn-secondary btn-sm">
                <i class="fas fa-film"></i> Quản lý phim
            </a>
            <a href="/admin/showtimes" class="btn btn-secondary btn-sm">
                <i class="fas fa-calendar-alt"></i> Quản lý suất chiếu
            </a>
            <a href="/admin/bookings" class="btn btn-secondary btn-sm">
                <i class="fas fa-ticket"></i> Quản lý đặt vé
            </a>
        </div>
    </div>

    <!-- 4 Key Performance Indicators (KPI Cards) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
        <!-- KPI 1: Phim -->
        <div class="card" style="border-left: 4px solid var(--color-primary); background: var(--bg-secondary);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="color: var(--text-muted); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Phim Đang Hoạt Động</div>
                    <div style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 800; color: #fff; margin-top: 0.25rem;">
                        <%= stats.totalMovies %>
                    </div>
                </div>
                <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: rgba(229, 9, 20, 0.15); display: flex; align-items: center; justify-content: center; color: var(--color-primary); font-size: 1.25rem;">
                    <i class="fas fa-film"></i>
                </div>
            </div>
            <div style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.75rem;">
                <i class="fas fa-circle-check" style="color: #10b981;"></i> Trong danh mục chiếu rạp
            </div>
        </div>

        <!-- KPI 2: Suất Chiếu -->
        <div class="card" style="border-left: 4px solid #06B6D4; background: var(--bg-secondary);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="color: var(--text-muted); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Suất Chiếu Đã Lên Lịch</div>
                    <div style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 800; color: #fff; margin-top: 0.25rem;">
                        <%= stats.totalShowtimes %>
                    </div>
                </div>
                <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: rgba(6, 182, 212, 0.15); display: flex; align-items: center; justify-content: center; color: #06B6D4; font-size: 1.25rem;">
                    <i class="fas fa-calendar-day"></i>
                </div>
            </div>
            <div style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.75rem;">
                <i class="fas fa-door-open" style="color: #06B6D4;"></i> Phòng chiếu đang mở bán
            </div>
        </div>

        <!-- KPI 3: Vé Đã Bán -->
        <div class="card" style="border-left: 4px solid #10B981; background: var(--bg-secondary);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="color: var(--text-muted); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Vé Đã Bán (Paid)</div>
                    <div style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 800; color: #fff; margin-top: 0.25rem;">
                        <%= stats.totalTicketsSold %>
                    </div>
                </div>
                <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: #10B981; font-size: 1.25rem;">
                    <i class="fas fa-ticket"></i>
                </div>
            </div>
            <div style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.75rem;">
                <i class="fas fa-circle-check" style="color: #10b981;"></i> Đã hoàn tất thanh toán
            </div>
        </div>

        <!-- KPI 4: Doanh Thu -->
        <div class="card" style="border-left: 4px solid var(--color-gold); background: var(--bg-secondary);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div style="color: var(--text-muted); font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Tổng Doanh Thu</div>
                    <div style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--color-gold); margin-top: 0.25rem;">
                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(stats.totalRevenue) %>
                    </div>
                </div>
                <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: rgba(245, 196, 81, 0.15); display: flex; align-items: center; justify-content: center; color: var(--color-gold); font-size: 1.25rem;">
                    <i class="fas fa-coins"></i>
                </div>
            </div>
            <div style="font-size: 0.82rem; color: var(--color-gold); margin-top: 0.75rem;">
                <i class="fas fa-database"></i> Dữ liệu ghi nhận từ MySQL
            </div>
        </div>
    </div>

    <!-- Quick Tools Links for Exam Presentation -->
    <div class="card" style="margin-bottom: 2.5rem; background: var(--bg-surface); border-color: var(--border-color);">
        <h3 style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.6rem;">
            <i class="fas fa-toolbox" style="color: var(--color-gold);"></i> Liên Kết Nhanh Công Cụ Giám Sát DevOps (Exam Live Demo)
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <a href="http://localhost:8080" target="_blank" class="card card-hover" style="padding: 1.25rem; text-align: center; border-color: var(--border-color); background: var(--bg-secondary);">
                <i class="fas fa-database" style="font-size: 1.8rem; color: var(--color-gold); margin-bottom: 0.5rem; display: block;"></i>
                <strong style="color: #fff; display: block; font-size: 0.95rem;">phpMyAdmin</strong>
                <span style="font-size: 0.78rem; color: var(--text-muted);">Port :8080</span>
            </a>
            <a href="http://localhost:3001" target="_blank" class="card card-hover" style="padding: 1.25rem; text-align: center; border-color: var(--border-color); background: var(--bg-secondary);">
                <i class="fas fa-chart-line" style="font-size: 1.8rem; color: #38bdf8; margin-bottom: 0.5rem; display: block;"></i>
                <strong style="color: #fff; display: block; font-size: 0.95rem;">Grafana Dashboard</strong>
                <span style="font-size: 0.78rem; color: var(--text-muted);">Port :3001</span>
            </a>
            <a href="http://localhost:9090/targets" target="_blank" class="card card-hover" style="padding: 1.25rem; text-align: center; border-color: var(--border-color); background: var(--bg-secondary);">
                <i class="fas fa-server" style="font-size: 1.8rem; color: #fb923c; margin-bottom: 0.5rem; display: block;"></i>
                <strong style="color: #fff; display: block; font-size: 0.95rem;">Prometheus Targets</strong>
                <span style="font-size: 0.78rem; color: var(--text-muted);">Port :9090</span>
            </a>
            <a href="/metrics" target="_blank" class="card card-hover" style="padding: 1.25rem; text-align: center; border-color: var(--border-color); background: var(--bg-secondary);">
                <i class="fas fa-code" style="font-size: 1.8rem; color: #a78bfa; margin-bottom: 0.5rem; display: block;"></i>
                <strong style="color: #fff; display: block; font-size: 0.95rem;">App Metrics</strong>
                <span style="font-size: 0.78rem; color: var(--text-muted);">/metrics</span>
            </a>
        </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="card" style="padding: 0; overflow: hidden; background: var(--bg-secondary); border-color: var(--border-color);">
        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-ticket" style="color: var(--color-primary);"></i> Đơn Đặt Vé Gần Đây
            </h3>
            <a href="/admin/bookings" class="btn btn-secondary btn-sm">Xem tất cả đơn vé</a>
        </div>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                    <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border-color); color: var(--text-muted); text-transform: uppercase; font-size: 0.76rem; letter-spacing: 0.8px;">
                        <th style="padding: 1rem 1.5rem;">Mã Đơn</th>
                        <th style="padding: 1rem 1.5rem;">Khách Hàng</th>
                        <th style="padding: 1rem 1.5rem;">Phim</th>
                        <th style="padding: 1rem 1.5rem;">Tổng Tiền</th>
                        <th style="padding: 1rem 1.5rem;">Trạng Thái</th>
                        <th style="padding: 1rem 1.5rem;">Thời Gian</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (stats.recentBookings && stats.recentBookings.length > 0) { %>
                        <% stats.recentBookings.forEach(b => { %>
                            <tr style="border-bottom: 1px solid var(--border-color); transition: var(--transition);" class="table-row-hover">
                                <td style="padding: 1rem 1.5rem; font-weight: 700; color: #fff;"><%= b.booking_code %></td>
                                <td style="padding: 1rem 1.5rem;">
                                    <div style="font-weight: 600; color: #fff;"><%= b.customer_name %></div>
                                    <div style="font-size: 0.78rem; color: var(--text-muted);"><%= b.customer_phone %></div>
                                </td>
                                <td style="padding: 1rem 1.5rem; color: var(--text-secondary);"><%= b.movie_title %></td>
                                <td style="padding: 1rem 1.5rem; font-weight: 800; color: var(--color-gold);">
                                    <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(b.total_amount) %>
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    <% if (b.payment_status === 'completed') { %>
                                        <span class="badge badge-green"><i class="fas fa-check"></i> Hoàn tất</span>
                                    <% } else if (b.payment_status === 'failed') { %>
                                        <span class="badge badge-red"><i class="fas fa-times"></i> Đã hủy</span>
                                    <% } else { %>
                                        <span class="badge badge-gold"><i class="fas fa-clock"></i> Pending</span>
                                    <% } %>
                                </td>
                                <td style="padding: 1rem 1.5rem; color: var(--text-muted); font-size: 0.82rem;">
                                    <%= new Date(b.created_at).toLocaleString('vi-VN') %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" style="padding: 2.5rem; text-align: center; color: var(--text-muted);">Chưa có đơn vé nào được ghi nhận.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<style>
.table-row-hover:hover {
    background: rgba(31, 41, 61, 0.6) !important;
}
</style>

<%- include('../partials/footer') %>
