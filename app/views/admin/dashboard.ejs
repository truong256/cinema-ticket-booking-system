<%- include('partials/admin_header', { title: 'Bảng Điều Khiển Quản Trị - CineVibe' }) %>
<%- include('partials/admin_sidebar', { activeTab: 'dashboard' }) %>

<main class="admin-main-wrapper">
    <%- include('partials/admin_topbar', { 
        pageTitle: 'Bảng điều khiển quản trị', 
        pageSubtitle: 'Theo dõi hoạt động kinh doanh và quản lý hệ thống đặt vé CineVibe.' 
    }) %>

    <div class="admin-content">
        <!-- 6 KPI Statistics Cards (Desktop: 3 cols x 2 rows, Tablet: 2 cols, Mobile: 1 col) -->
        <section class="admin-kpi-grid">
            <!-- KPI 1: Phim đang chiếu -->
            <div class="admin-kpi-card admin-kpi-movies">
                <div class="admin-kpi-label">Phim đang chiếu</div>
                <div class="admin-kpi-value"><%= stats.totalMovies %></div>
                <div class="admin-kpi-desc">Phim Đang Hoạt Động mở bán</div>
            </div>

            <!-- KPI 2: Suất chiếu mở bán -->
            <div class="admin-kpi-card admin-kpi-showtimes">
                <div class="admin-kpi-label">Suất chiếu mở bán</div>
                <div class="admin-kpi-value"><%= stats.totalShowtimes %></div>
                <div class="admin-kpi-desc">Đã lên lịch phát sóng</div>
            </div>

            <!-- KPI 3: Vé đã bán -->
            <div class="admin-kpi-card admin-kpi-tickets">
                <div class="admin-kpi-label">Vé đã bán</div>
                <div class="admin-kpi-value" style="color: var(--admin-success);"><%= stats.totalTicketsSold %></div>
                <div class="admin-kpi-desc">Giao dịch hoàn tất</div>
            </div>

            <!-- KPI 4: Tổng doanh thu -->
            <div class="admin-kpi-card admin-kpi-revenue">
                <div class="admin-kpi-label">Tổng doanh thu</div>
                <div class="admin-kpi-value">
                    <%= Number(stats.totalRevenue).toLocaleString('vi-VN') %> đ
                </div>
                <div class="admin-kpi-desc" style="color: var(--admin-accent-gold);">Doanh thu thực tế</div>
            </div>

            <!-- KPI 5: Đơn đang giữ chỗ -->
            <div class="admin-kpi-card admin-kpi-pending">
                <div class="admin-kpi-label">Đơn đang giữ chỗ</div>
                <div class="admin-kpi-value" style="color: var(--admin-warning);"><%= stats.totalPending || 0 %></div>
                <div class="admin-kpi-desc">Trong thời hạn 10 phút</div>
            </div>

            <!-- KPI 6: Khách hàng đăng ký -->
            <div class="admin-kpi-card admin-kpi-users">
                <div class="admin-kpi-label">Khách hàng đăng ký</div>
                <div class="admin-kpi-value" style="color: #A78BFA;"><%= stats.totalUsers || 0 %></div>
                <div class="admin-kpi-desc">Thành viên hệ thống</div>
            </div>
        </section>

        <!-- 2-Column Analytics Section: Top Movies & 7-Day Revenue Chart -->
        <div class="admin-dashboard-analytics-grid">
            <!-- 1. Top Movies by Revenue -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h2 class="admin-card-title">Top phim có doanh thu cao nhất</h2>
                    <span class="admin-card-badge">Bán chạy nhất</span>
                </div>

                <% if (typeof topMovies !== 'undefined' && topMovies && topMovies.length > 0) { %>
                    <div class="admin-top-movies-list">
                        <% topMovies.forEach((m, idx) => { %>
                            <div class="admin-top-movie-item <%= idx === 0 ? 'top-rank-1' : '' %>">
                                <div class="admin-movie-rank">#<%= idx + 1 %></div>
                                <img src="<%= m.poster_url %>" alt="<%= m.title %>" class="admin-movie-poster" onerror="this.src='/images/dune2.jpg'">
                                <div class="admin-movie-meta">
                                    <div class="admin-movie-title"><%= m.title %></div>
                                    <div class="admin-movie-sub"><%= m.genre || 'Phim rạp' %> &bull; <%= m.tickets_count || 0 %> vé đã bán</div>
                                </div>
                                <div class="admin-movie-revenue">
                                    <div class="admin-movie-amount">
                                        <%= Number(m.total_revenue).toLocaleString('vi-VN') %> đ
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="admin-empty-state">
                        <div class="admin-empty-state-title">Chưa có dữ liệu doanh thu</div>
                        <p>Hệ thống chưa ghi nhận vé đã thanh toán để xếp hạng phim.</p>
                    </div>
                <% } %>
            </div>

            <!-- 2. 7-Day Revenue Bar Chart -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h2 class="admin-card-title">Doanh thu 7 ngày gần nhất</h2>
                    <span class="admin-pill-badge">Theo ngày</span>
                </div>

                <% 
                const hasRevenueData = typeof dailyRevenue !== 'undefined' && dailyRevenue && dailyRevenue.length > 0;
                let sum7Days = 0;
                let maxRevDay = null;
                let maxRevVal = 0;

                if (hasRevenueData) {
                    dailyRevenue.forEach(d => {
                        const val = parseFloat(d.daily_total) || 0;
                        sum7Days += val;
                        if (val >= maxRevVal) {
                            maxRevVal = val;
                            maxRevDay = d;
                        }
                    });
                }
                const avgDaily = hasRevenueData ? Math.round(sum7Days / dailyRevenue.length) : 0;
                %>

                <div class="admin-chart-container">
                    <% if (hasRevenueData) { 
                        const chartScale = Math.max(maxRevVal, 100000);
                    %>
                        <!-- Visual Bar Chart -->
                        <div class="admin-bar-chart">
                            <% dailyRevenue.forEach(d => { 
                                const val = parseFloat(d.daily_total) || 0;
                                const heightPercent = Math.max(6, Math.min(100, Math.round((val / chartScale) * 100)));
                                const dateObj = new Date(d.date_label);
                                const dateFormatted = dateObj.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
                            %>
                                <div class="admin-chart-column-wrap">
                                    <span class="admin-chart-bar-hover-val"><%= val > 0 ? (val >= 1000000 ? (val/1000000).toFixed(1) + 'M' : Math.round(val/1000) + 'k') : '0' %></span>
                                    <div class="admin-chart-bar" style="height: <%= heightPercent %>%;" title="<%= dateFormatted %>: <%= Number(val).toLocaleString('vi-VN') %> đ"></div>
                                    <span class="admin-chart-x-label"><%= dateFormatted %></span>
                                </div>
                            <% }); %>
                        </div>

                        <!-- 3 Summary Metrics Below Chart -->
                        <div class="admin-chart-metrics-row">
                            <div class="admin-chart-metric-box">
                                <div class="admin-metric-box-label">Tổng kỳ 7 ngày</div>
                                <div class="admin-metric-box-val gold"><%= Number(sum7Days).toLocaleString('vi-VN') %> đ</div>
                            </div>
                            <div class="admin-chart-metric-box">
                                <div class="admin-metric-box-label">Trung bình/ngày</div>
                                <div class="admin-metric-box-val"><%= Number(avgDaily).toLocaleString('vi-VN') %> đ</div>
                            </div>
                            <div class="admin-chart-metric-box">
                                <div class="admin-metric-box-label">Cao nhất (<%= maxRevDay ? new Date(maxRevDay.date_label).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }) : '--' %>)</div>
                                <div class="admin-metric-box-val gold"><%= Number(maxRevVal).toLocaleString('vi-VN') %> đ</div>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="admin-empty-state">
                            <div class="admin-empty-state-title">Chưa có giao dịch gần đây</div>
                            <p>Không có giao dịch thanh toán thành công trong 7 ngày gần nhất.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Recent Bookings Table -->
        <div class="admin-card" style="padding: 0; overflow: hidden; margin-bottom: 2rem;">
            <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center;">
                <h2 class="admin-card-title">Đơn đặt vé mới nhất</h2>
                <a href="/admin/bookings" class="admin-btn admin-btn-secondary admin-btn-sm">
                    Xem tất cả đơn vé
                </a>
            </div>

            <div class="admin-table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Phim</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof recentBookings !== 'undefined' && recentBookings && recentBookings.length > 0) { %>
                            <% recentBookings.forEach(b => { %>
                                <tr>
                                    <td style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #FFFFFF;">
                                        <%= b.booking_code %>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600; color: #FFFFFF;"><%= b.customer_name %></div>
                                        <div style="font-size: 0.78rem; color: var(--admin-text-muted);"><%= b.customer_phone %></div>
                                    </td>
                                    <td style="color: var(--admin-text-secondary);"><%= b.movie_title %></td>
                                    <td style="font-weight: 800; color: var(--admin-accent-gold);">
                                        <%= Number(b.total_amount).toLocaleString('vi-VN') %> đ
                                    </td>
                                    <td>
                                        <% if (b.payment_status === 'completed' || b.payment_status === 'paid') { %>
                                            <span class="admin-tag admin-tag-success">Hoàn tất</span>
                                        <% } else if (b.payment_status === 'failed' || b.booking_status === 'cancelled') { %>
                                            <span class="admin-tag admin-tag-danger">Đã hủy</span>
                                        <% } else { %>
                                            <span class="admin-tag admin-tag-warning">Đang giữ chỗ</span>
                                        <% } %>
                                    </td>
                                    <td style="color: var(--admin-text-muted); font-size: 0.8rem;">
                                        <%= new Date(b.created_at).toLocaleString('vi-VN') %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="padding: 2.5rem; text-align: center; color: var(--admin-text-muted);">
                                    Chưa có đơn vé nào trong hệ thống.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick DevOps Monitoring Links -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">Công cụ giám sát hạ tầng & DevOps</h2>
                <span class="admin-pill-badge">Hệ thống</span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
                <a href="http://localhost:8080" target="_blank" class="admin-card" style="padding: 1.15rem; text-align: center; text-decoration: none; background: var(--admin-bg-surface);">
                    <div style="font-size: 0.72rem; font-weight: 700; color: var(--admin-accent-gold); text-transform: uppercase; margin-bottom: 0.25rem;">Cơ sở dữ liệu</div>
                    <div style="font-weight: 700; color: #FFFFFF; font-size: 0.95rem;">phpMyAdmin</div>
                    <div style="font-size: 0.75rem; color: var(--admin-text-muted); margin-top: 0.25rem;">Cổng :8080</div>
                </a>
                <a href="http://localhost:3001" target="_blank" class="admin-card" style="padding: 1.15rem; text-align: center; text-decoration: none; background: var(--admin-bg-surface);">
                    <div style="font-size: 0.72rem; font-weight: 700; color: #38BDF8; text-transform: uppercase; margin-bottom: 0.25rem;">Giám sát Dashboard</div>
                    <div style="font-weight: 700; color: #FFFFFF; font-size: 0.95rem;">Grafana</div>
                    <div style="font-size: 0.75rem; color: var(--admin-text-muted); margin-top: 0.25rem;">Cổng :3001</div>
                </a>
                <a href="http://localhost:9090/targets" target="_blank" class="admin-card" style="padding: 1.15rem; text-align: center; text-decoration: none; background: var(--admin-bg-surface);">
                    <div style="font-size: 0.72rem; font-weight: 700; color: #FB923C; text-transform: uppercase; margin-bottom: 0.25rem;">Chỉ số thu thập</div>
                    <div style="font-weight: 700; color: #FFFFFF; font-size: 0.95rem;">Prometheus Targets</div>
                    <div style="font-size: 0.75rem; color: var(--admin-text-muted); margin-top: 0.25rem;">Cổng :9090</div>
                </a>
                <a href="/metrics" target="_blank" class="admin-card" style="padding: 1.15rem; text-align: center; text-decoration: none; background: var(--admin-bg-surface);">
                    <div style="font-size: 0.72rem; font-weight: 700; color: #A78BFA; text-transform: uppercase; margin-bottom: 0.25rem;">Dữ liệu ứng dụng</div>
                    <div style="font-weight: 700; color: #FFFFFF; font-size: 0.95rem;">Endpoint /metrics</div>
                    <div style="font-size: 0.75rem; color: var(--admin-text-muted); margin-top: 0.25rem;">Prometheus Client</div>
                </a>
            </div>
        </div>
    </div>
</main>

<%- include('partials/admin_footer') %>
