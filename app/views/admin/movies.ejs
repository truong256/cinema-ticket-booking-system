<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <div class="section-header">
        <div>
            <a href="/admin" style="color: var(--primary); font-size: 0.85rem;"><i class="fas fa-chevron-left"></i> Quay lại Dashboard</a>
            <h1 class="section-title" style="margin-top: 0.25rem;"><i class="fas fa-film"></i> Quản Lý Danh Sách Phim</h1>
        </div>
        <button class="btn btn-primary btn-sm" onclick="document.getElementById('modalAddMovie').style.display='block'">
            <i class="fas fa-plus"></i> Thêm phim mới
        </button>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <!-- Movies Table -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2rem;">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                    <tr style="background: rgba(15, 23, 42, 0.8); border-bottom: 1px solid var(--border-color); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem;">
                        <th style="padding: 1rem;">ID</th>
                        <th style="padding: 1rem;">Poster</th>
                        <th style="padding: 1rem;">Tên Phim</th>
                        <th style="padding: 1rem;">Thể Loại</th>
                        <th style="padding: 1rem;">Thời Lượng</th>
                        <th style="padding: 1rem;">Độ Tuổi</th>
                        <th style="padding: 1rem;">Trạng Thái</th>
                        <th style="padding: 1rem; text-align: right;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    <% movies.forEach(m => { %>
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 1rem; color: var(--text-muted);"><%= m.id %></td>
                            <td style="padding: 1rem;">
                                <img src="<%= m.poster_url %>" alt="" style="width: 45px; height: 65px; border-radius: 4px; object-fit: cover;">
                            </td>
                            <td style="padding: 1rem; font-weight: 700; color: #fff;"><%= m.title %></td>
                            <td style="padding: 1rem; color: var(--text-secondary);"><%= m.genre %></td>
                            <td style="padding: 1rem;"><%= m.duration_minutes %> phút</td>
                            <td style="padding: 1rem;"><span class="age-badge <%= m.age_rating %>" style="position: static;"><%= m.age_rating %></span></td>
                            <td style="padding: 1rem;">
                                <% if (m.is_active) { %>
                                    <span style="color: #6ee7b7; font-weight: 600;"><i class="fas fa-eye"></i> Đang hiển thị</span>
                                <% } else { %>
                                    <span style="color: #fca5a5; font-weight: 600;"><i class="fas fa-eye-slash"></i> Đã ẩn</span>
                                <% } %>
                            </td>
                            <td style="padding: 1rem; text-align: right;">
                                <div style="display: inline-flex; gap: 0.4rem;">
                                    <form action="/admin/movies/<%= m.id %>/toggle" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-secondary btn-sm" title="Bật/Tắt hiển thị">
                                            <i class="fas <%= m.is_active ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                                        </button>
                                    </form>
                                    <form action="/admin/movies/<%= m.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn xóa phim này?')">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Xóa phim (chỉ xóa nếu không có suất chiếu)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Add Movie -->
    <div id="modalAddMovie" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 2000; overflow-y: auto; padding: 2rem 1rem;">
        <div class="card" style="max-width: 600px; margin: 2rem auto; background: #0f172a; border-color: var(--primary);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h3 style="font-family: var(--font-heading); font-size: 1.3rem;"><i class="fas fa-film"></i> Thêm Phim Mới</h3>
                <button type="button" onclick="document.getElementById('modalAddMovie').style.display='none'" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>

            <form action="/admin/movies/create" method="POST">
                <div class="form-group">
                    <label class="form-label">Tên phim *</label>
                    <input type="text" name="title" class="form-control" required placeholder="Nhập tên phim">
                </div>
                <div class="form-group">
                    <label class="form-label">Tóm tắt nội dung *</label>
                    <textarea name="description" class="form-control" rows="3" required placeholder="Nội dung tóm tắt"></textarea>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Thời lượng (phút) *</label>
                        <input type="number" name="duration_minutes" class="form-control" required value="120">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ngày khởi chiếu *</label>
                        <input type="date" name="release_date" class="form-control" required value="2026-04-01">
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Thể loại *</label>
                        <input type="text" name="genre" class="form-control" required placeholder="Hành động, Phiêu lưu">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Độ tuổi phân loại</label>
                        <select name="age_rating" class="form-control">
                            <option value="P">P (Mọi lứa tuổi)</option>
                            <option value="K">K (Dưới 13 tuổi kèm người lớn)</option>
                            <option value="T16">T16 (Từ 16 tuổi trở lên)</option>
                            <option value="T18">T18 (Từ 18 tuổi trở lên)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Poster URL</label>
                    <input type="text" name="poster_url" class="form-control" value="/images/dune2.jpg">
                </div>
                <div class="form-group">
                    <label class="form-label">Trailer Youtube URL</label>
                    <input type="url" name="trailer_url" class="form-control" placeholder="https://www.youtube.com/watch?v=...">
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                    <button type="button" onclick="document.getElementById('modalAddMovie').style.display='none'" class="btn btn-secondary">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu phim</button>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
