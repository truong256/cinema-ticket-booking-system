<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <div class="section-header">
        <div>
            <a href="/admin" style="color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.4rem;">
                &larr; Quay lại Dashboard
            </a>
            <h1 class="section-title">Quản Lý Danh Sách Phim</h1>
            <p class="section-subtitle">Thêm mới, bật/tắt hiển thị và quản lý các tác phẩm điện ảnh trong hệ thống CINEVIBE</p>
        </div>
        <button class="btn btn-primary" onclick="document.getElementById('modalAddMovie').style.display='flex'">
            Thêm phim mới
        </button>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
    <% } %>

    <!-- Movies Table Card -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2.5rem;">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th style="width: 80px;">Poster</th>
                        <th>Tên Phim</th>
                        <th>Thể Loại</th>
                        <th>Thời Lượng</th>
                        <th>Độ Tuổi</th>
                        <th>Trạng Thái</th>
                        <th style="text-align: right;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (movies && movies.length > 0) { %>
                        <% movies.forEach(m => { %>
                            <tr>
                                <td style="color: var(--text-muted); font-weight: 600;">#<%= m.id %></td>
                                <td>
                                    <img src="<%= m.poster_url %>" alt="<%= m.title %>" style="width: 46px; height: 68px; border-radius: 6px; object-fit: cover; border: 1px solid var(--border-color); display: block;" onerror="this.src='/images/dune2.jpg'">
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: #ffffff; font-size: 0.98rem; margin-bottom: 0.2rem;"><%= m.title %></div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted);"><%= m.release_date ? new Date(m.release_date).toLocaleDateString('vi-VN') : 'Sắp chiếu' %></div>
                                </td>
                                <td style="color: var(--text-secondary); font-weight: 500;"><%= m.genre %></td>
                                <td><span style="color: var(--text-primary); font-weight: 600;"><%= m.duration_minutes %></span> <span style="font-size: 0.8rem; color: var(--text-muted);">phút</span></td>
                                <td>
                                    <span class="age-badge <%= m.age_rating %>" style="position: static; display: inline-block;"><%= m.age_rating %></span>
                                </td>
                                <td>
                                    <% if (m.is_active) { %>
                                        <span class="badge badge-green">Đang hiển thị</span>
                                    <% } else { %>
                                        <span class="badge badge-red">Đã ẩn</span>
                                    <% } %>
                                </td>
                                <td style="text-align: right;">
                                    <div style="display: inline-flex; gap: 0.5rem;">
                                        <form action="/admin/movies/<%= m.id %>/toggle" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-secondary btn-sm" title="Bật/Tắt hiển thị" aria-label="Bật hoặc tắt hiển thị" style="padding: 0.4rem 0.65rem;">
                                                <i class="fas <%= m.is_active ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                                            </button>
                                        </form>
                                        <form action="/admin/movies/<%= m.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn xóa phim này?')">
                                            <button type="submit" class="btn btn-secondary btn-sm" title="Xóa phim (chỉ xóa nếu không có suất chiếu)" aria-label="Xóa phim" style="color: #fca5a5; border-color: rgba(239, 68, 68, 0.4); padding: 0.4rem 0.65rem;">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                                Chưa có phim nào trong cơ sở dữ liệu. Nhấn "Thêm phim mới" để khởi tạo.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Add Movie (Dark Cinema Luxury) -->
    <div id="modalAddMovie" class="modal-overlay">
        <div class="modal-content-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">
                <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0;">Thêm Phim Mới</h3>
                <button type="button" onclick="document.getElementById('modalAddMovie').style.display='none'" style="background: none; border: none; color: var(--text-secondary); font-size: 1.5rem; cursor: pointer; line-height: 1; transition: var(--transition);" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--text-secondary)'">&times;</button>
            </div>

            <form action="/admin/movies/create" method="POST">
                <div class="form-group">
                    <label class="form-label">Tên phim <span style="color: var(--color-primary);">*</span></label>
                    <input type="text" name="title" class="form-control" required placeholder="Nhập tên phim chính thức">
                </div>
                <div class="form-group">
                    <label class="form-label">Tóm tắt nội dung <span style="color: var(--color-primary);">*</span></label>
                    <textarea name="description" class="form-control" rows="3" required placeholder="Nội dung tóm tắt cốt truyện..."></textarea>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Thời lượng (phút) <span style="color: var(--color-primary);">*</span></label>
                        <input type="number" name="duration_minutes" class="form-control" required value="120" min="1">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ngày khởi chiếu <span style="color: var(--color-primary);">*</span></label>
                        <input type="date" name="release_date" class="form-control" required value="2026-04-01">
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Thể loại <span style="color: var(--color-primary);">*</span></label>
                        <input type="text" name="genre" class="form-control" required placeholder="Hành động, Phiêu lưu">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phân loại độ tuổi</label>
                        <select name="age_rating" class="form-control">
                            <option value="P">P — Mọi lứa tuổi</option>
                            <option value="K">K — Dưới 13 tuổi có người lớn</option>
                            <option value="T16">T16 — Khán giả từ 16 tuổi</option>
                            <option value="T18">T18 — Khán giả từ 18 tuổi</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Poster URL</label>
                    <input type="text" name="poster_url" class="form-control" value="/images/dune2.jpg" placeholder="/images/dune2.jpg hoặc https://...">
                </div>
                <div class="form-group">
                    <label class="form-label">Trailer Youtube URL</label>
                    <input type="url" name="trailer_url" class="form-control" placeholder="https://www.youtube.com/watch?v=...">
                </div>

                <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.75rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                    <button type="button" onclick="document.getElementById('modalAddMovie').style.display='none'" class="btn btn-secondary">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu phim</button>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
