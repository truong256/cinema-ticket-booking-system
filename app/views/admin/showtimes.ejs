<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <div class="section-header">
        <div>
            <a href="/admin" style="color: var(--primary); font-size: 0.85rem;"><i class="fas fa-chevron-left"></i> Quay lại Dashboard</a>
            <h1 class="section-title" style="margin-top: 0.25rem;"><i class="fas fa-calendar-alt"></i> Quản Lý Suất Chiếu</h1>
        </div>
        <button class="btn btn-primary btn-sm" onclick="document.getElementById('modalAddShowtime').style.display='block'">
            <i class="fas fa-plus"></i> Thêm suất chiếu mới
        </button>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2rem;">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                    <tr style="background: rgba(15, 23, 42, 0.8); border-bottom: 1px solid var(--border-color); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem;">
                        <th style="padding: 1rem;">ID</th>
                        <th style="padding: 1rem;">Phim</th>
                        <th style="padding: 1rem;">Rạp & Phòng</th>
                        <th style="padding: 1rem;">Thời Gian Bắt Đầu</th>
                        <th style="padding: 1rem;">Giá Thường / VIP / Đôi</th>
                        <th style="padding: 1rem;">Trạng Thái</th>
                        <th style="padding: 1rem; text-align: right;">Xem Sơ Đồ</th>
                    </tr>
                </thead>
                <tbody>
                    <% showtimes.forEach(st => { %>
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 1rem; color: var(--text-muted);"><%= st.id %></td>
                            <td style="padding: 1rem; font-weight: 700; color: #fff;"><%= st.movie_title %></td>
                            <td style="padding: 1rem; color: var(--text-secondary);">
                                <%= st.cinema_name %> - <strong><%= st.room_name %></strong>
                            </td>
                            <td style="padding: 1rem; color: #a5b4fc;">
                                <%= new Date(st.start_time).toLocaleString('vi-VN') %>
                            </td>
                            <td style="padding: 1rem; font-size: 0.85rem;">
                                <%= new Intl.NumberFormat('vi-VN').format(st.price_regular) %> / 
                                <span style="color: #fbbf24;"><%= new Intl.NumberFormat('vi-VN').format(st.price_vip) %></span> / 
                                <span style="color: #f472b6;"><%= new Intl.NumberFormat('vi-VN').format(st.price_couple) %></span>
                            </td>
                            <td style="padding: 1rem;">
                                <span style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                                    <%= st.status %>
                                </span>
                            </td>
                            <td style="padding: 1rem; text-align: right;">
                                <a href="/booking/showtime/<%= st.id %>" class="btn btn-secondary btn-sm" target="_blank">
                                    <i class="fas fa-couch"></i> Ghế
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Add Showtime -->
    <div id="modalAddShowtime" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 2000; overflow-y: auto; padding: 2rem 1rem;">
        <div class="card" style="max-width: 600px; margin: 2rem auto; background: #0f172a; border-color: var(--primary);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h3 style="font-family: var(--font-heading); font-size: 1.3rem;"><i class="fas fa-calendar-plus"></i> Tạo Suất Chiếu Mới</h3>
                <button type="button" onclick="document.getElementById('modalAddShowtime').style.display='none'" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
            </div>

            <form action="/admin/showtimes/create" method="POST">
                <div class="form-group">
                    <label class="form-label">Chọn Phim *</label>
                    <select name="movie_id" class="form-control" required>
                        <% movies.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.title %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Chọn Phòng Chiếu *</label>
                    <select name="room_id" class="form-control" required>
                        <% rooms.forEach(r => { %>
                            <option value="<%= r.id %>"><%= r.cinema_name %> - <%= r.name %> (<%= r.room_type %>)</option>
                        <% }); %>
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Thời gian bắt đầu *</label>
                        <input type="datetime-local" name="start_time" class="form-control" required value="2026-04-10T19:30">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Thời lượng dự kiến (phút)</label>
                        <input type="number" name="duration_minutes" class="form-control" value="130">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem;">
                    <div class="form-group">
                        <label class="form-label">Giá vé thường (VND)</label>
                        <input type="number" name="price_regular" class="form-control" value="85000">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Giá vé VIP (VND)</label>
                        <input type="number" name="price_vip" class="form-control" value="110000">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Giá vé Đôi (VND)</label>
                        <input type="number" name="price_couple" class="form-control" value="180000">
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                    <button type="button" onclick="document.getElementById('modalAddShowtime').style.display='none'" class="btn btn-secondary">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Tạo suất chiếu</button>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
