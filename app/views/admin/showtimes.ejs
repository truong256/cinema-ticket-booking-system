<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <div class="section-header">
        <div>
            <a href="/admin" style="color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; margin-bottom: 0.4rem;">
                <i class="fas fa-chevron-left"></i> Quay lại Dashboard
            </a>
            <h1 class="section-title"><i class="fas fa-calendar-alt"></i> Quản Lý Suất Chiếu</h1>
            <p class="section-subtitle">Lên lịch chiếu phim, phân bổ phòng chiếu và thiết lập biểu giá vé theo thời gian thực</p>
        </div>
        <button class="btn btn-primary" onclick="document.getElementById('modalAddShowtime').style.display='flex'">
            <i class="fas fa-plus"></i> Thêm suất chiếu mới
        </button>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    <% if (success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>

    <!-- Showtimes Table Card -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2.5rem;">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tên Phim</th>
                        <th>Cụm Rạp & Phòng</th>
                        <th>Thời Gian Chiếu</th>
                        <th>Biểu Giá (Thường / VIP / Đôi)</th>
                        <th>Trạng Thái</th>
                        <th style="text-align: right;">Sơ Đồ Ghế</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (showtimes && showtimes.length > 0) { %>
                        <% showtimes.forEach(st => { %>
                            <tr>
                                <td style="color: var(--text-muted); font-weight: 600;">#<%= st.id %></td>
                                <td>
                                    <div style="font-weight: 700; color: #ffffff; font-size: 0.98rem;"><%= st.movie_title %></div>
                                </td>
                                <td>
                                    <div style="color: var(--text-primary); font-weight: 600; font-size: 0.92rem;"><%= st.cinema_name %></div>
                                    <div style="font-size: 0.8rem; color: var(--color-gold); font-weight: 600;"><i class="fas fa-door-open"></i> <%= st.room_name %></div>
                                </td>
                                <td>
                                    <div style="color: #ffffff; font-weight: 600; display: flex; align-items: center; gap: 0.35rem;">
                                        <i class="far fa-clock" style="color: var(--color-primary);"></i>
                                        <%= new Date(st.start_time).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                    <div style="font-size: 0.8rem; color: var(--text-muted);">
                                        <%= new Date(st.start_time).toLocaleDateString('vi-VN') %>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-size: 0.88rem; font-weight: 600;">
                                        <span style="color: var(--text-primary);"><%= new Intl.NumberFormat('vi-VN').format(st.price_regular) %>đ</span>
                                        <span style="color: var(--border-color); margin: 0 0.25rem;">/</span>
                                        <span style="color: var(--color-gold);"><%= new Intl.NumberFormat('vi-VN').format(st.price_vip) %>đ</span>
                                        <span style="color: var(--border-color); margin: 0 0.25rem;">/</span>
                                        <span style="color: #f472b6;"><%= new Intl.NumberFormat('vi-VN').format(st.price_couple) %>đ</span>
                                    </div>
                                    <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Standard / VIP / Couple</div>
                                </td>
                                <td>
                                    <span class="badge badge-green">
                                        <i class="fas fa-check-circle"></i> <%= st.status %>
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <a href="/booking/showtime/<%= st.id %>" class="btn btn-secondary btn-sm" target="_blank" style="padding: 0.45rem 0.85rem;">
                                        <i class="fas fa-couch" style="color: var(--color-gold);"></i> Ghế
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                                <i class="fas fa-calendar-times" style="font-size: 2.5rem; color: var(--border-color); display: block; margin-bottom: 0.75rem;"></i>
                                Chưa có suất chiếu nào. Nhấn "Thêm suất chiếu mới" để thiết lập lịch chiếu.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Add Showtime (Dark Cinema Luxury) -->
    <div id="modalAddShowtime" class="modal-overlay">
        <div class="modal-content-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(229, 9, 20, 0.15); border: 1px solid rgba(229, 9, 20, 0.35); display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
                        <i class="fas fa-calendar-plus"></i>
                    </div>
                    <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0;">Tạo Suất Chiếu Mới</h3>
                </div>
                <button type="button" onclick="document.getElementById('modalAddShowtime').style.display='none'" style="background: none; border: none; color: var(--text-secondary); font-size: 1.5rem; cursor: pointer; line-height: 1; transition: var(--transition);" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--text-secondary)'">&times;</button>
            </div>

            <form action="/admin/showtimes/create" method="POST">
                <div class="form-group">
                    <label class="form-label">Chọn Phim <span style="color: var(--color-primary);">*</span></label>
                    <select name="movie_id" class="form-control" required>
                        <% movies.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.title %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Chọn Phòng Chiếu <span style="color: var(--color-primary);">*</span></label>
                    <select name="room_id" class="form-control" required>
                        <% rooms.forEach(r => { %>
                            <option value="<%= r.id %>"><%= r.cinema_name %> - <%= r.name %> (<%= r.room_type %>)</option>
                        <% }); %>
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Thời gian bắt đầu <span style="color: var(--color-primary);">*</span></label>
                        <input type="datetime-local" name="start_time" class="form-control" required value="2026-04-10T19:30">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Thời lượng dự kiến (phút)</label>
                        <input type="number" name="duration_minutes" class="form-control" value="130">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem;">
                    <div class="form-group">
                        <label class="form-label">Vé thường (VNĐ)</label>
                        <input type="number" name="price_regular" class="form-control" value="85000" step="5000">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Vé VIP (VNĐ)</label>
                        <input type="number" name="price_vip" class="form-control" value="110000" step="5000">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Vé Đôi (VNĐ)</label>
                        <input type="number" name="price_couple" class="form-control" value="180000" step="5000">
                    </div>
                </div>

                <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.75rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                    <button type="button" onclick="document.getElementById('modalAddShowtime').style.display='none'" class="btn btn-secondary">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Tạo suất chiếu</button>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
