<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper" style="max-width: 680px; text-align: center; padding-top: 3.5rem;">
    <div class="card" style="padding: 3.5rem 2.5rem; background: var(--bg-secondary); border-color: var(--border-color); box-shadow: var(--shadow-elevated);">
        <!-- Failure Icon -->
        <div style="width: 88px; height: 88px; background: rgba(229, 9, 20, 0.12); border: 2px solid var(--color-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.75rem; color: var(--color-primary); font-size: 2.5rem; box-shadow: 0 0 25px rgba(229, 9, 20, 0.25);">
            <i class="fas fa-times"></i>
        </div>

        <span class="brand-badge" style="background: rgba(229, 9, 20, 0.2); color: #FCA5A5; margin-bottom: 0.75rem;">GIAO DỊCH CHƯA HOÀN TẤT</span>
        
        <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; color: #FFFFFF; margin-bottom: 1rem; letter-spacing: -0.5px;">
            Thanh Toán Không Thành Công
        </h1>

        <p style="color: var(--text-secondary); font-size: 1.05rem; margin-bottom: 1.75rem; line-height: 1.7;">
            Giao dịch thanh toán đã bị hủy bỏ hoặc cổng thanh toán không xác nhận được kết quả. 
            Theo cơ chế toàn vẹn dữ liệu ACID của CineVibe, <strong>các ghế bạn vừa giữ chỗ đã được tự động giải phóng ngay lập tức</strong> để đảm bảo không bị khóa ghế ảo.
        </p>

        <% if (booking) { %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1.25rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 2.25rem; font-size: 0.92rem; text-align: left; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                <div>
                    <span style="color: var(--text-muted); font-size: 0.82rem; display: block;">Mã đơn vé liên quan:</span>
                    <strong style="color: #FCA5A5; letter-spacing: 0.5px; font-family: var(--font-mono);"><%= booking.booking_code %></strong>
                </div>
                <div>
                    <span class="badge badge-red"><i class="fas fa-rotate-left"></i> Ghế đã giải phóng</span>
                </div>
            </div>
        <% } %>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/movies" class="btn btn-primary btn-lg">
                <i class="fas fa-rotate-right"></i> Chọn và đặt lại vé
            </a>
            <a href="/" class="btn btn-secondary btn-lg">
                <i class="fas fa-home"></i> Về trang chủ
            </a>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
