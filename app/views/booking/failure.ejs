<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper" style="max-width: 650px; text-align: center; padding-top: 3rem;">
    <div class="card" style="padding: 3rem 2rem;">
        <div style="width: 80px; height: 80px; background: rgba(239, 68, 68, 0.15); border: 2px solid #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: #ef4444; font-size: 2.2rem;">
            <i class="fas fa-times"></i>
        </div>

        <h1 style="font-family: var(--font-heading); font-size: 2rem; color: #fff; margin-bottom: 1rem;">
            Thanh Toán Không Thành Công
        </h1>

        <p style="color: var(--text-secondary); font-size: 1rem; margin-bottom: 1.5rem; line-height: 1.6;">
            Giao dịch thanh toán giả lập đã bị hủy hoặc gặp lỗi xác thực từ phía cổng thanh toán. 
            Theo quy tắc an toàn của hệ thống, <strong>các ghế bạn vừa giữ chỗ đã được tự động giải phóng</strong> để phục vụ khách hàng khác.
        </p>

        <% if (booking) { %>
            <div style="background: rgba(15, 23, 42, 0.6); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 2rem; font-size: 0.9rem; text-align: left;">
                <div>Mã giao dịch lỗi: <code style="color: #fca5a5;"><%= booking.booking_code %></code></div>
                <div>Trạng thái đơn vé: <span class="badge" style="color: #ef4444; font-weight: 700;">ĐÃ HỦY / GIẢI PHÓNG GHẾ</span></div>
            </div>
        <% } %>

        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/movies" class="btn btn-primary"><i class="fas fa-redo"></i> Chọn và đặt lại vé</a>
            <a href="/" class="btn btn-secondary"><i class="fas fa-home"></i> Về trang chủ</a>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
