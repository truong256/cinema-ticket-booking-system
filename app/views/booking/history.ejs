<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <!-- Header -->
    <div class="section-header">
        <div>
            <span class="brand-badge gold" style="margin-bottom: 0.5rem;">QUẢN LÝ VÉ CỦA TÔI</span>
            <h1 class="section-title">
                <i class="fas fa-ticket"></i> Lịch Sử Đặt Vé & Hóa Đơn
            </h1>
            <p class="section-subtitle">Tra cứu toàn bộ thông tin các đơn vé xem phim bạn đã đặt và mở lại vé điện tử bất kỳ lúc nào</p>
        </div>
        <a href="/movies" class="btn btn-primary btn-sm">
            <i class="fas fa-ticket"></i> Đặt vé mới
        </a>
    </div>

    <div class="card" style="padding: 0; overflow: hidden; background: var(--bg-secondary); border-color: var(--border-color);">
        <% if (bookings && bookings.length > 0) { %>
            <div class="table-responsive">
                <table class="cinema-table">
                    <thead>
                        <tr>
                            <th>Mã Đơn Vé</th>
                            <th>Bộ Phim & Rạp</th>
                            <th>Suất Chiếu</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th style="text-align: right;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(b => { %>
                            <tr>
                                <td style="font-weight: 700; color: #FFFFFF; font-family: var(--font-mono); letter-spacing: 0.5px;">
                                    <%= b.booking_code %>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: #FFFFFF; font-size: 1rem;"><%= b.movie_title %></div>
                                    <div style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                        <i class="fas fa-location-dot" style="color: var(--color-gold);"></i> <%= b.cinema_name %> &bull; <%= b.room_name %>
                                    </div>
                                </td>
                                <td style="color: var(--text-secondary);">
                                    <div style="font-weight: 600; color: #FFFFFF;"><%= new Date(b.start_time).toLocaleDateString('vi-VN') %></div>
                                    <div style="font-size: 0.82rem; color: var(--color-gold); font-weight: 700;"><%= new Date(b.start_time).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %></div>
                                </td>
                                <td style="font-weight: 800; color: var(--color-gold); font-size: 1.05rem;">
                                    <%= Number(b.total_amount).toLocaleString('vi-VN') %> đ
                                </td>
                                <td>
                                    <% if (b.payment_status === 'completed') { %>
                                        <span class="badge badge-green">
                                            <i class="fas fa-circle-check"></i> Đã thanh toán
                                        </span>
                                    <% } else if (b.payment_status === 'failed') { %>
                                        <span class="badge badge-red">
                                            <i class="fas fa-circle-xmark"></i> Đã hủy
                                        </span>
                                    <% } else { %>
                                        <span class="badge badge-gold">
                                            <i class="fas fa-clock"></i> Chờ thanh toán
                                        </span>
                                    <% } %>
                                </td>
                                <td style="text-align: right;">
                                    <% if (b.payment_status === 'completed') { %>
                                        <a href="/booking/success/<%= b.id %>" class="btn btn-secondary btn-sm" title="Xem vé điện tử chi tiết">
                                            <i class="fas fa-ticket"></i> Xem vé
                                        </a>
                                    <% } else if (b.payment_status === 'pending') { %>
                                        <a href="/booking/payment/<%= b.id %>" class="btn btn-primary btn-sm" title="Tiếp tục thanh toán đơn">
                                            <i class="fas fa-credit-card"></i> Thanh toán
                                        </a>
                                    <% } else { %>
                                        <a href="/movies" class="btn btn-secondary btn-sm" title="Đặt vé mới">
                                            <i class="fas fa-redo"></i> Đặt lại
                                        </a>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 4.5rem 2rem;">
                <div style="width: 70px; height: 70px; border-radius: 50%; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: var(--text-muted); font-size: 2rem; border: 1px solid var(--border-color);">
                    <i class="fas fa-ticket"></i>
                </div>
                <h3 style="color: #FFFFFF; margin-bottom: 0.5rem; font-size: 1.25rem; font-weight: 700;">Bạn chưa có đơn đặt vé nào</h3>
                <p style="color: var(--text-secondary); max-width: 400px; margin: 0 auto 1.5rem; font-size: 0.95rem;">Hãy khám phá các tác phẩm điện ảnh bom tấn đang chiếu và đặt ngay những vị trí ghế đẹp nhất.</p>
                <a href="/movies" class="btn btn-primary btn-sm"><i class="fas fa-clapperboard"></i> Khám phá phim ngay</a>
            </div>
        <% } %>
    </div>
</main>

<%- include('../partials/footer') %>
