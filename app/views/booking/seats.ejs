<%- include('../partials/header', { extraCss: '/css/seats.css' }) %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
    <!-- Breadcrumb & Showtime Info Header -->
    <div style="margin-bottom: 2rem;">
        <a href="/movies/<%= showtime.movie_id %>" style="color: var(--text-secondary); font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem; transition: var(--transition);">
            <i class="fas fa-chevron-left"></i> Quay lại chi tiết phim
        </a>
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 0.5rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <span class="brand-badge gold" style="margin-bottom: 0.4rem;">SƠ ĐỒ PHÒNG CHIẾU</span>
                <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; color: #fff;">
                    <%= showtime.movie_title %>
                </h1>
                <div style="color: var(--text-secondary); font-size: 0.95rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin-top: 0.25rem;">
                    <span><i class="fas fa-location-dot" style="color: var(--color-gold);"></i> <%= showtime.cinema_name %></span> &bull; 
                    <span><i class="fas fa-door-open"></i> <%= showtime.room_name %> (<%= showtime.room_type || 'Standard' %>)</span> &bull; 
                    <span style="color: var(--color-gold); font-weight: 700;"><i class="far fa-clock"></i> <%= new Date(showtime.start_time).toLocaleString('vi-VN') %></span>
                </div>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <span class="badge badge-gold"><i class="fas fa-eye"></i> Thời gian thực</span>
                <span class="badge badge-red"><i class="fas fa-lock"></i> ACID Transaction</span>
            </div>
        </div>
    </div>

    <!-- Hidden configuration inputs required by seats.js -->
    <input type="hidden" id="showtimeId" value="<%= showtime.id %>">
    <input type="hidden" id="priceRegular" value="<%= showtime.price_regular %>">
    <input type="hidden" id="priceVip" value="<%= showtime.price_vip %>">
    <input type="hidden" id="priceCouple" value="<%= showtime.price_couple %>">

    <div class="booking-container">
        <!-- Left: Cinema Room Layout -->
        <div class="card" style="padding: 2.5rem 1.75rem; background: var(--bg-secondary); border-color: var(--border-color);">
            <!-- Screen with Curved Glow -->
            <div class="cinema-screen-wrap">
                <div class="cinema-screen"></div>
                <div class="screen-text">
                    <i class="fas fa-film"></i> MÀN HÌNH CHIẾU CHÍNH (SCREEN)
                </div>
            </div>

            <!-- Seat Rows Grid -->
            <div class="seating-area">
                <% for (const [rowLabel, seatsInRow] of Object.entries(seatRows)) { %>
                    <div class="seat-row">
                        <div class="row-label"><%= rowLabel %></div>
                        <% seatsInRow.forEach(seat => { %>
                            <div class="seat <%= seat.seat_type.toLowerCase() %> <%= seat.isBooked ? 'booked' : '' %>"
                                 data-id="<%= seat.id %>"
                                 data-label="<%= seat.row_label %><%= seat.seat_number %>"
                                 data-type="<%= seat.seat_type %>"
                                 title="Ghế <%= seat.row_label %><%= seat.seat_number %> - <%= seat.seat_type %> <%= seat.isBooked ? '(Đã có người đặt)' : '' %>">
                                <%= seat.seat_number %>
                            </div>
                        <% }); %>
                        <div class="row-label"><%= rowLabel %></div>
                    </div>
                <% } %>
            </div>

            <!-- Seat Legend -->
            <div class="seat-legend">
                <div class="legend-item">
                    <span class="legend-badge" style="background: #20293A; border: 1px solid #2D394E;"></span>
                    <span>Ghế Thường: <strong style="color: #fff;"><%= new Intl.NumberFormat('vi-VN').format(showtime.price_regular) %> đ</strong></span>
                </div>
                <div class="legend-item">
                    <span class="legend-badge" style="background: rgba(245, 196, 81, 0.15); border: 1px solid var(--color-gold);"></span>
                    <span>Ghế VIP: <strong style="color: var(--color-gold);"><%= new Intl.NumberFormat('vi-VN').format(showtime.price_vip) %> đ</strong></span>
                </div>
                <div class="legend-item">
                    <span class="legend-badge" style="background: var(--color-primary); border: 1px solid #ffffff; box-shadow: 0 0 8px rgba(229,9,20,0.6);"></span>
                    <span>Đang chọn</span>
                </div>
                <div class="legend-item">
                    <span class="legend-badge" style="background: #131924; border: 1px solid #1D2433; opacity: 0.5;"></span>
                    <span>Đã bán</span>
                </div>
            </div>
        </div>

        <!-- Right: Booking Summary & Customer Information Form -->
        <div class="summary-card">
            <h3 class="summary-title">
                <i class="fas fa-receipt" style="color: var(--color-primary);"></i> Thông Tin Đặt Vé
            </h3>

            <div class="summary-row">
                <span>Phim:</span>
                <strong title="<%= showtime.movie_title %>"><%= showtime.movie_title %></strong>
            </div>
            <div class="summary-row">
                <span>Rạp chiếu:</span>
                <strong><%= showtime.cinema_name %></strong>
            </div>
            <div class="summary-row">
                <span>Phòng:</span>
                <strong><%= showtime.room_name %> (<%= showtime.room_type || 'Standard' %>)</strong>
            </div>
            <div class="summary-row">
                <span>Suất chiếu:</span>
                <strong style="color: var(--color-gold);"><%= new Date(showtime.start_time).toLocaleString('vi-VN') %></strong>
            </div>

            <!-- Selected Seats Box (Filled dynamically by seats.js) -->
            <div style="margin: 1.25rem 0 0.5rem 0;">
                <div style="font-size: 0.88rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.5rem;">
                    Ghế đã chọn:
                </div>
                <div class="selected-seats-box" id="selectedSeatsList">
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Chưa có ghế nào được chọn</span>
                </div>
            </div>

            <div class="summary-row" style="border-top: 1px solid var(--border-color); padding-top: 1rem; margin-top: 1rem;">
                <span style="font-size: 1rem; font-weight: 700; color: #fff;">Tổng tiền:</span>
                <span class="total-price" id="totalPrice">0 đ</span>
            </div>

            <!-- Customer Booking Form -->
            <form id="bookingForm" style="margin-top: 1.5rem;">
                <div class="form-group">
                    <label class="form-label" for="customerName">Họ và tên người nhận vé *</label>
                    <input type="text" id="customerName" name="customerName" class="form-control" required 
                           value="<%= currentUser ? (currentUser.full_name || currentUser.username) : '' %>" 
                           placeholder="Nguyễn Văn A">
                </div>

                <div class="form-group">
                    <label class="form-label" for="customerEmail">Email nhận vé điện tử *</label>
                    <input type="email" id="customerEmail" name="customerEmail" class="form-control" required 
                           value="<%= currentUser ? (currentUser.email || '') : '' %>" 
                           placeholder="email@example.com">
                </div>

                <div class="form-group">
                    <label class="form-label" for="customerPhone">Số điện thoại *</label>
                    <input type="tel" id="customerPhone" name="customerPhone" class="form-control" required 
                           value="<%= currentUser ? (currentUser.phone || '') : '' %>" 
                           placeholder="0912345678">
                </div>

                <button type="submit" id="btnSubmitBooking" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.85rem;" disabled>
                    <i class="fas fa-ticket"></i> Tiếp tục thanh toán
                </button>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer', { extraJs: '/js/seats.js' }) %>
