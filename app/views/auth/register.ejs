<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper" style="max-width: 540px; padding-top: 3rem; padding-bottom: 3.5rem;">
    <div class="card" style="padding: 2.75rem 2.25rem; background: var(--bg-secondary); border-color: var(--border-color); box-shadow: var(--shadow-elevated);">
        <!-- Form Header -->
        <div style="text-align: center; margin-bottom: 2.25rem;">
            <div class="brand-logo" style="justify-content: center; margin-bottom: 0.75rem;">
                <i class="fas fa-film" style="color: var(--color-primary);"></i>
                <span>CINE<span style="color: var(--color-primary);">VIBE</span></span>
            </div>
            <h1 style="font-family: var(--font-heading); font-size: 1.75rem; font-weight: 800; color: #fff; letter-spacing: -0.5px;">
                Đăng Ký Thành Viên Mới
            </h1>
            <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.25rem;">
                Mật khẩu được mã hóa an toàn bằng tiêu chuẩn <strong>bcrypt (rounds 10)</strong>
            </p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger">
                <i class="fas fa-triangle-exclamation"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <form action="/auth/register" method="POST">
            <div class="form-group">
                <label class="form-label" for="full_name">
                    <i class="fas fa-id-card" style="color: var(--color-gold); margin-right: 0.35rem;"></i> Họ và tên người dùng *
                </label>
                <input type="text" id="full_name" name="full_name" class="form-control" required value="<%= formData?.full_name || '' %>" placeholder="Nguyễn Văn A">
            </div>

            <div class="form-group">
                <label class="form-label" for="username">
                    <i class="fas fa-user" style="color: var(--color-gold); margin-right: 0.35rem;"></i> Tên đăng nhập *
                </label>
                <input type="text" id="username" name="username" class="form-control" required value="<%= formData?.username || '' %>" placeholder="username123">
            </div>

            <div class="form-group">
                <label class="form-label" for="email">
                    <i class="fas fa-envelope" style="color: var(--color-gold); margin-right: 0.35rem;"></i> Địa chỉ Email *
                </label>
                <input type="email" id="email" name="email" class="form-control" required value="<%= formData?.email || '' %>" placeholder="email@domain.com">
            </div>

            <div class="form-group">
                <label class="form-label" for="phone">
                    <i class="fas fa-phone" style="color: var(--color-gold); margin-right: 0.35rem;"></i> Số điện thoại
                </label>
                <input type="tel" id="phone" name="phone" class="form-control" value="<%= formData?.phone || '' %>" placeholder="0912345678">
            </div>

            <div class="form-group">
                <label class="form-label" for="password">
                    <i class="fas fa-lock" style="color: var(--color-gold); margin-right: 0.35rem;"></i> Mật khẩu bảo vệ *
                </label>
                <input type="password" id="password" name="password" class="form-control" required placeholder="Tối thiểu 6 ký tự">
            </div>

            <div class="form-group">
                <label class="form-label" for="confirm_password">
                    <i class="fas fa-check-double" style="color: var(--color-gold); margin-right: 0.35rem;"></i> Xác nhận mật khẩu *
                </label>
                <input type="password" id="confirm_password" name="confirm_password" class="form-control" required placeholder="Nhập lại mật khẩu để xác thực">
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 1rem;">
                <i class="fas fa-user-plus"></i> Hoàn tất đăng ký
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.75rem; font-size: 0.92rem; color: var(--text-secondary);">
            Đã có tài khoản CineVibe? <a href="/auth/login" style="color: var(--color-primary); font-weight: 700;">Đăng nhập ngay</a>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
