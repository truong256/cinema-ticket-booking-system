<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<link rel="stylesheet" href="/css/auth.css">

<main class="auth-page">
    <div class="auth-container">
        <div class="auth-split-layout">
            <!-- Left Side: Login Form Panel -->
            <div class="auth-form-panel">
                <div class="auth-brand-badge">
                    <span>THÀNH VIÊN CINEVIBE</span>
                </div>

                <div class="auth-form-header">
                    <h1>Chào mừng trở lại!</h1>
                    <p>Đăng nhập để tiếp tục hành trình điện ảnh cùng CINEVIBE.</p>
                </div>

                <!-- Feedback Alerts -->
                <% if (error) { %>
                    <div class="auth-alert auth-alert-danger" role="alert">
                        <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="auth-alert auth-alert-success" role="alert">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                        <div><%= success %></div>
                    </div>
                <% } %>

                <!-- Login Form -->
                <form action="/auth/login" method="POST" id="loginForm" class="auth-form" autocomplete="on">
                    <!-- Username or Email Field -->
                    <div class="auth-field-group">
                        <label class="auth-label" for="username">
                            Tên đăng nhập hoặc Email <span class="required-star">*</span>
                        </label>
                        <div class="auth-input-wrapper">
                            <input type="text" id="username" name="username" class="auth-input" required placeholder="Nhập username hoặc địa chỉ email" autocomplete="username">
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="auth-field-group">
                        <label class="auth-label" for="password">
                            Mật khẩu <span class="required-star">*</span>
                        </label>
                        <div class="auth-input-wrapper">
                            <input type="password" id="password" name="password" class="auth-input has-toggle" required placeholder="Nhập mật khẩu của bạn" autocomplete="current-password">
                            <button type="button" class="auth-password-toggle" onclick="togglePasswordVisibility('password', this)" title="Hiển thị mật khẩu" aria-label="Hiển thị mật khẩu">
                                <i class="far fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="auth-submit-btn">
                        <span class="auth-btn-spinner" aria-hidden="true"></span>
                        <span class="auth-btn-text">Đăng nhập ngay</span>
                    </button>
                </form>

                <!-- Switch Link -->
                <div class="auth-switch-prompt">
                    Chưa có tài khoản?
                    <a href="/auth/register" class="auth-switch-link">Đăng ký thành viên ngay</a>
                </div>
            </div>

            <!-- Right Side: Movie Poster Gallery (Cinema City Style) -->
            <div class="auth-poster-gallery" aria-label="Bộ sưu tập phim chiếu rạp CineVibe">
                <div class="gallery-glow-backdrop" aria-hidden="true"></div>
                
                <div class="poster-stack-container">
                    <!-- Poster 1 (Far Left, -18deg) -->
                    <div class="tilted-poster poster-far-left" tabindex="0" aria-label="Poster phim Godzilla x Kong">
                        <img src="/images/godzilla_kong.jpg" alt="Poster Godzilla x Kong" loading="lazy" onerror="this.src='/images/default_poster.jpg'">
                        <div class="poster-glass-gloss" aria-hidden="true"></div>
                        <div class="poster-badge">Hành Động</div>
                    </div>

                    <!-- Poster 2 (Left, -10deg) -->
                    <div class="tilted-poster poster-left" tabindex="0" aria-label="Poster phim Mai">
                        <img src="/images/mai.jpg" alt="Poster Mai" loading="lazy" onerror="this.src='/images/default_poster.jpg'">
                        <div class="poster-glass-gloss" aria-hidden="true"></div>
                        <div class="poster-badge">Tâm Lý &bull; Lãng Mạn</div>
                    </div>

                    <!-- Poster 3 (Center Hero, 0deg) -->
                    <div class="tilted-poster poster-center" tabindex="0" aria-label="Poster phim Dune: Hành Tinh Cát 2">
                        <img src="/images/dune2.jpg" alt="Poster Dune 2" loading="eager" onerror="this.src='/images/default_poster.jpg'">
                        <div class="poster-glass-gloss" aria-hidden="true"></div>
                        <div class="poster-badge"><i class="fas fa-crown" style="color: var(--color-gold);"></i> Dune: Part Two</div>
                    </div>

                    <!-- Poster 4 (Right, +10deg) -->
                    <div class="tilted-poster poster-right" tabindex="0" aria-label="Poster phim Oppenheimer">
                        <img src="/images/oppenheimer.jpg" alt="Poster Oppenheimer" loading="lazy" onerror="this.src='/images/default_poster.jpg'">
                        <div class="poster-glass-gloss" aria-hidden="true"></div>
                        <div class="poster-badge">Kịch Tính &bull; Lịch Sử</div>
                    </div>

                    <!-- Poster 5 (Far Right, +18deg) -->
                    <div class="tilted-poster poster-far-right" tabindex="0" aria-label="Poster phim Inside Out 2">
                        <img src="/images/inside_out2.jpg" alt="Poster Inside Out 2" loading="lazy" onerror="this.src='/images/default_poster.jpg'">
                        <div class="poster-glass-gloss" aria-hidden="true"></div>
                        <div class="poster-badge">Hoạt Hình</div>
                    </div>
                </div>

                <div class="gallery-caption">
                    <h2 class="gallery-title">MỖI BỘ PHIM, MỘT HÀNH TRÌNH</h2>
                    <p class="gallery-desc">Khám phá những câu chuyện đáng nhớ cùng CINEVIBE.</p>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="/js/auth.js"></script>

<%- include('../partials/footer') %>
