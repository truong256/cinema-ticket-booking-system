<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<link rel="stylesheet" href="/css/auth.css">

<main class="auth-page">
    <div class="auth-container" style="max-width: 520px; margin: 0 auto;">
        <div class="card" style="padding: 2.75rem 2.25rem;">
            <div class="auth-brand-badge" style="margin-bottom: 1rem;">
                <span>KHÔI PHỤC MẬT KHẨU</span>
            </div>

            <div class="auth-form-header" style="margin-bottom: 1.75rem;">
                <h1 style="font-size: 1.85rem;">Quên Mật Khẩu?</h1>
                <p>Nhập email đăng ký tài khoản CineVibe của bạn. Chúng tôi sẽ khởi tạo liên kết bảo mật để bạn thiết lập lại mật khẩu.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger" style="margin-bottom: 1.5rem; padding: 0.85rem 1.15rem;">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success" style="margin-bottom: 1.5rem; padding: 0.85rem 1.15rem;">
                    <%= success %>
                </div>
            <% } %>

            <form action="/auth/forgot-password" method="POST" class="auth-form">
                <div class="auth-field-group" style="margin-bottom: 1.5rem;">
                    <label class="auth-label" for="email">
                        Địa chỉ Email của bạn <span class="required-star">*</span>
                    </label>
                    <div class="auth-input-wrapper">
                        <input type="email" id="email" name="email" class="auth-input" required placeholder="nhapemail@example.com" autocomplete="email">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center;">
                    Gửi Liên Kết Khôi Phục
                </button>
            </form>

            <div style="text-align: center; margin-top: 1.75rem; border-top: 1px solid var(--border-color); padding-top: 1.25rem; font-size: 0.88rem; color: var(--text-secondary);">
                Nhớ lại mật khẩu rồi? 
                <a href="/auth/login" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
