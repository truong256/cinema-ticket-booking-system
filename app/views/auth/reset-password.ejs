<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<link rel="stylesheet" href="/css/auth.css">

<main class="auth-page">
    <div class="auth-container" style="max-width: 520px; margin: 0 auto;">
        <div class="card" style="padding: 2.75rem 2.25rem;">
            <div class="auth-brand-badge" style="margin-bottom: 1rem;">
                <span>THIẾT LẬP MẬT KHẨU MỚI</span>
            </div>

            <div class="auth-form-header" style="margin-bottom: 1.75rem;">
                <h1 style="font-size: 1.85rem;">Đặt Lại Mật Khẩu</h1>
                <p>Nhập mật khẩu mới an toàn cho tài khoản CineVibe của bạn.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger" style="margin-bottom: 1.5rem; padding: 0.85rem 1.15rem;">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof token !== 'undefined' && token) { %>
                <form action="/auth/reset-password/<%= token %>" method="POST" class="auth-form">
                    <div class="auth-field-group" style="margin-bottom: 1.25rem;">
                        <label class="auth-label" for="password">
                            Mật khẩu mới (tối thiểu 6 ký tự) <span class="required-star">*</span>
                        </label>
                        <div class="auth-input-wrapper">
                            <input type="password" id="password" name="password" class="auth-input" required minlength="6" placeholder="Nhập mật khẩu mới">
                        </div>
                    </div>

                    <div class="auth-field-group" style="margin-bottom: 1.75rem;">
                        <label class="auth-label" for="confirm_password">
                            Xác nhận mật khẩu mới <span class="required-star">*</span>
                        </label>
                        <div class="auth-input-wrapper">
                            <input type="password" id="confirm_password" name="confirm_password" class="auth-input" required minlength="6" placeholder="Nhập lại mật khẩu mới">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center;">
                        Xác Nhận Đổi Mật Khẩu
                    </button>
                </form>
            <% } else { %>
                <div style="text-align: center; margin-top: 1.5rem;">
                    <a href="/auth/forgot-password" class="btn btn-primary">Gửi lại yêu cầu khôi phục</a>
                </div>
            <% } %>

            <div style="text-align: center; margin-top: 1.75rem; border-top: 1px solid var(--border-color); padding-top: 1.25rem; font-size: 0.88rem; color: var(--text-secondary);">
                <a href="/auth/login" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">&larr; Trở về Đăng nhập</a>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
